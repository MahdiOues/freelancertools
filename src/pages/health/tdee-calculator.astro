---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free TDEE Calculator",
  "description": "Calculate your Total Daily Energy Expenditure. Get BMR, TDEE, and calorie targets for weight loss, maintenance, and muscle gain.",
  "url": "https://www.megalancer.online/health/tdee-calculator/",
  "applicationCategory": "HealthApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="TDEE Calculator — Daily Energy Needs"
  description="Calculate how many calories you burn daily. Get your BMR, TDEE, and personalized calorie targets for weight loss, maintenance, and muscle gain."
  canonicalUrl="https://www.megalancer.online/health/tdee-calculator/"
  schema={schema}
  breadcrumb={[{ label: 'Health', href: '/health/' }, { label: 'TDEE Calculator' }]}
  relatedTools={[
    { name: 'BMI Calculator', href: '/health/bmi-calculator/', category: 'Health' },
    { name: 'Calories Burned Calculator', href: '/health/calories-burned/', category: 'Health' },
    { name: 'Water Intake Calculator', href: '/health/water-intake/', category: 'Health' },
    { name: 'Sleep Calculator', href: '/health/sleep-calculator/', category: 'Health' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>TDEE Calculator</h1>
      <p class="subhead">Find out how many calories you need daily for weight loss, maintenance, or muscle gain based on your activity level.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>TDEE Calculator</h2>
      </div>
      <div class="calculator-card-body">
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Age" tip="Your age in years. BMR decreases slightly with age." /></label>
            <input type="number" id="age" value="30" />
          </div>
          <div class="field">
            <label class="field-label">Gender</label>
            <select id="gender">
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Height (cm)" tip="Your height in centimeters." /></label>
            <input type="number" id="height" value="175" />
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Weight (kg)" tip="Your weight in kilograms." /></label>
            <input type="number" id="weight" value="70" step="0.1" />
          </div>
        </div>
        <div class="field">
          <label class="field-label"><KpiTooltip label="Activity level" tip="How physically active you are in daily life and exercise." /></label>
          <select id="activity">
            <option value="1.2">Sedentary — little or no exercise</option>
            <option value="1.375">Light — 1-3 days/week</option>
            <option value="1.55" selected>Moderate — 3-5 days/week</option>
            <option value="1.725">Active — 6-7 days/week</option>
            <option value="1.9">Very active — intense daily / physical job</option>
          </select>
        </div>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Enter your details to calculate TDEE.</div>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>What is TDEE?</h2>
      <p>Total Daily Energy Expenditure (TDEE) is the total number of calories your body burns in a day. It includes your Basal Metabolic Rate (BMR) — the calories you burn at rest — plus the calories you burn through physical activity and digestion.</p>
      <p>Your TDEE is the number you need to know for weight management. Eat more than your TDEE and you gain weight. Eat less and you lose weight. Eat the same and you maintain.</p>
      <h2>How to use this calculator</h2>
      <p>Enter your age, gender, height, and weight to calculate your BMR using the Mifflin-St Jeor equation, the most accurate formula for the general population. Then select your activity level to get your TDEE and three calorie targets: weight loss (TDEE minus 500), maintenance (TDEE), and muscle gain (TDEE plus 300).</p>
      <p>These are estimates. Actual calorie needs vary based on genetics, medical conditions, and other factors. Adjust based on your real-world results.</p>
      <p>For informational purposes only. Consult a healthcare professional.</p>
      <div class="sources">
        <h3>Sources</h3>
        <ul>
          <li><a href="https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight" rel="nofollow noopener" target="_blank">World Health Organization — BMI Classification</a></li>
          <li>Mifflin-St Jeor equation: Mifflin MD et al. (1990). American Journal of Clinical Nutrition.</li>
        </ul>
      </div>
    </div>
  </fragment>
</Tool>

<script>
function calculate() {
  const age = parseInt(document.getElementById('age').value) || 30;
  const gender = document.getElementById('gender').value;
  const height = parseFloat(document.getElementById('height').value) || 175;
  const weight = parseFloat(document.getElementById('weight').value) || 70;
  const mult = parseFloat(document.getElementById('activity').value) || 1.55;

  const bmr = (10 * weight) + (6.25 * height) - (5 * age) + (gender === 'male' ? 5 : -161);
  const tdee = bmr * mult;

  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">${Math.round(bmr)}</div>
        <div class="result-label"><span class="kpi-tooltip-wrapper">BMR<button class="kpi-info-btn" data-tip="Basal Metabolic Rate — calories your body burns at rest just to stay alive." tabindex="0" type="button">i</button></span></div>
      </div>
      <div class="metric-card">
        <div class="result-number">${Math.round(tdee)}</div>
        <div class="result-label"><span class="kpi-tooltip-wrapper">TDEE<button class="kpi-info-btn" data-tip="Total Daily Energy Expenditure — total calories burned per day including activity." tabindex="0" type="button">i</button></span></div>
      </div>
    </div>
    <div style="margin-top:20px;">
      <table style="width:100%;border-collapse:collapse;font-size:14px;">
        <tr style="border-bottom:1px solid var(--border);"><td style="padding:10px 0;font-weight:600;">Weight loss</td><td style="padding:10px 0;text-align:right;color:var(--danger);font-weight:600;">${Math.round(tdee - 500)} cal</td><td style="padding:10px 0;text-align:right;color:var(--text-muted);">TDEE - 500</td></tr>
        <tr style="border-bottom:1px solid var(--border);"><td style="padding:10px 0;font-weight:600;">Maintenance</td><td style="padding:10px 0;text-align:right;font-weight:600;">${Math.round(tdee)} cal</td><td style="padding:10px 0;text-align:right;color:var(--text-muted);">TDEE</td></tr>
        <tr><td style="padding:10px 0;font-weight:600;">Muscle gain</td><td style="padding:10px 0;text-align:right;color:var(--success);font-weight:600;">${Math.round(tdee + 300)} cal</td><td style="padding:10px 0;text-align:right;color:var(--text-muted);">TDEE + 300</td></tr>
      </table>
    </div>
  `;
}

['age','gender','height','weight','activity'].forEach(id => document.getElementById(id).addEventListener('input', calculate));
calculate();
</script>
