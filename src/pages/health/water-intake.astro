---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Water Intake Calculator",
  "description": "Calculate how much water you should drink daily based on your weight, activity level, and climate. Get an hourly schedule.",
  "url": "https://freelancertools.io/health/water-intake/",
  "applicationCategory": "HealthApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Free Water Intake Calculator — How Much Water Should I Drink?"
  description="Calculate your daily water intake needs based on weight, activity level, and climate. Get an hourly drinking schedule."
  canonicalUrl="https://freelancertools.io/health/water-intake/"
  schema={schema}
  breadcrumb={[{ label: 'Health', href: '/health/' }, { label: 'Water Intake Calculator' }]}
  relatedTools={[
    { name: 'Calories Burned Calculator', href: '/health/calories-burned/', category: 'Health' },
    { name: 'BMI Calculator', href: '/health/bmi-calculator/', category: 'Health' },
    { name: 'TDEE Calculator', href: '/health/tdee-calculator/', category: 'Health' },
    { name: 'Sleep Calculator', href: '/health/sleep-calculator/', category: 'Health' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Water Intake Calculator</h1>
      <p class="subhead">Find out how much water you need to drink each day based on your body, activity, and environment.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Water Intake Calculator</h2>
      </div>
      <div class="calculator-card-body">
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Weight (kg)" tip="Your body weight in kilograms." /></label>
            <input type="number" id="weight" value="70" />
          </div>
          <div class="field">
            <label class="field-label">Activity level</label>
            <select id="activity">
              <option value="1.0">Sedentary — little exercise</option>
              <option value="1.2" selected>Moderate — 3-5 days/week</option>
              <option value="1.5">Active — daily exercise</option>
              <option value="1.8">Very active — intense daily</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label class="field-label">Climate</label>
          <select id="climate">
            <option value="1.0">Cool / mild</option>
            <option value="1.15" selected>Moderate</option>
            <option value="1.3">Hot / humid</option>
          </select>
        </div>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Enter your details to calculate water intake.</div>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>How much water do you need?</h2>
      <p>A common recommendation is 8 glasses (64 oz / 1.9 L) per day, but individual needs vary. Your water requirement depends on your body weight, how active you are, and the climate you live in. A more accurate formula: weight (kg) × 30-40 mL per kg, adjusted for activity and heat.</p>
      <p>This calculator uses your weight as the base and adjusts for activity level (more activity = more water lost through sweat) and climate (hot climates increase fluid needs). It shows results in both ounces and milliliters for convenience.</p>
      <h2>Signs of dehydration</h2>
      <p>Dark urine, dry mouth, fatigue, headache, dizziness, and reduced urine output are common signs of dehydration. If you're thirsty, you're already mildly dehydrated. Drink water throughout the day rather than chugging large amounts at once. The hourly schedule helps you spread your intake evenly.</p>
      <p>For informational purposes only. Consult a healthcare professional.</p>
    </div>
  </fragment>
</Tool>

<script>
function calculate() {
  const weight = parseFloat(document.getElementById('weight').value) || 70;
  const activity = parseFloat(document.getElementById('activity').value) || 1.2;
  const climate = parseFloat(document.getElementById('climate').value) || 1.0;

  const baseMl = weight * 33;
  const totalMl = baseMl * activity * climate;
  const totalOz = totalMl / 29.5735;
  const cups = totalOz / 8;
  const hourly = totalOz / 16;

  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">${Math.round(totalOz)} oz</div>
        <div class="result-label">Daily water intake</div>
      </div>
      <div class="metric-card">
        <div class="result-number">${Math.round(totalMl)} mL</div>
        <div class="result-label">Daily in milliliters</div>
      </div>
      <div class="metric-card">
        <div class="result-number">${cups.toFixed(1)}</div>
        <div class="result-label">8-oz cups per day</div>
      </div>
    </div>
    <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border-light);">
      <p style="font-size:14px;color:var(--text-secondary);">💧 Drink about <strong>${hourly.toFixed(1)} oz</strong> per hour over 16 waking hours.</p>
    </div>
  `;
}
['weight','activity','climate'].forEach(id => document.getElementById(id).addEventListener('input', calculate));
calculate();
</script>
