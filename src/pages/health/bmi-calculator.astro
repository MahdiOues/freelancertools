---
import Tool from '../../layouts/ToolWithCharts.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free BMI Calculator",
  "description": "Calculate your Body Mass Index. Get your BMI value, weight category, and healthy weight range. Metric and imperial units.",
  "url": "https://www.megalancer.online/health/bmi-calculator/",
  "applicationCategory": "HealthApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Free BMI Calculator — Body Mass Index"
  description="Calculate your BMI instantly. Enter your height and weight to get your BMI value, weight category, and healthy weight range. Metric or imperial units."
  canonicalUrl="https://www.megalancer.online/health/bmi-calculator/"
  schema={schema}
  breadcrumb={[{ label: 'Health', href: '/health/' }, { label: 'BMI Calculator' }]}
  relatedTools={[
    { name: 'TDEE Calculator', href: '/health/tdee-calculator/', category: 'Health' },
    { name: 'Calories Burned Calculator', href: '/health/calories-burned/', category: 'Health' },
    { name: 'Water Intake Calculator', href: '/health/water-intake/', category: 'Health' },
    { name: 'Sleep Calculator', href: '/health/sleep-calculator/', category: 'Health' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>BMI Calculator</h1>
      <p class="subhead">Calculate your Body Mass Index to assess your weight category. For informational purposes — consult a healthcare professional.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>BMI Calculator</h2>
      </div>
      <div class="calculator-card-body">
        <div class="field">
          <label class="field-label">Units</label>
          <select id="units">
            <option value="metric">Metric (cm / kg)</option>
            <option value="imperial">Imperial (ft / in / lbs)</option>
          </select>
        </div>
        <div class="field-grid">
          <div class="field" id="heightGroup">
            <label class="field-label"><KpiTooltip label="Height" tip="Your height. Use metric or imperial depending on the selected unit system." /></label>
            <input type="number" id="height" value="175" step="0.1" />
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Weight" tip="Your weight. Use kilograms or pounds depending on the selected unit system." /></label>
            <input type="number" id="weight" value="70" step="0.1" />
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Age" tip="Used to interpret BMI. BMI categories are the same for adults 20+." /></label>
            <input type="number" id="age" value="30" />
          </div>
          <div class="field">
            <label class="field-label">Gender</label>
            <select id="gender">
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
        </div>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Enter your details to calculate BMI.</div>
        </div>

        <div style="margin-top:24px;">
          <canvas id="gauge" style="max-height:200px;"></canvas>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>What is BMI?</h2>
      <p>Body Mass Index (BMI) is a simple calculation using your height and weight. The formula is weight in kilograms divided by height in meters squared. BMI is a screening tool — it helps identify if you are underweight, normal weight, overweight, or obese, but it does not measure body fat directly.</p>
      <p>For most adults, a BMI between 18.5 and 24.9 is considered healthy. Below 18.5 is underweight, 25-29.9 is overweight, and 30 or above is obese. These ranges apply to both men and women.</p>
      <h2>Limitations of BMI</h2>
      <p>BMI does not account for muscle mass, bone density, body composition, or fat distribution. Athletes with high muscle mass may have a high BMI but low body fat. Older adults may have more body fat than BMI suggests. Use BMI as a general guideline, not a diagnostic tool.</p>
      <p>For a more complete picture, combine BMI with other measurements like waist circumference, body fat percentage, and overall fitness level. This calculator shows your healthy weight range to give you a target zone.</p>
      <p>For informational purposes only. Consult a healthcare professional.</p>
      <div class="sources">
        <h3>Sources</h3>
        <ul>
          <li><a href="https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight" rel="nofollow noopener" target="_blank">World Health Organization — BMI Classification</a></li>
        </ul>
      </div>
    </div>
  </fragment>
</Tool>

<script>
let gaugeChart = null;

function calculate() {
  const units = document.getElementById('units').value;
  const age = parseInt(document.getElementById('age').value) || 30;
  let height, weight;
  if (units === 'metric') {
    height = (parseFloat(document.getElementById('height').value) || 0) / 100;
    weight = parseFloat(document.getElementById('weight').value) || 0;
  } else {
    height = (parseFloat(document.getElementById('height').value) || 0) * 0.0254;
    weight = (parseFloat(document.getElementById('weight').value) || 0) * 0.453592;
  }
  if (height <= 0 || weight <= 0) {
    document.getElementById('resultArea').innerHTML = `<div class="result-empty">Please enter valid measurements.</div>`;
    return;
  }
  const bmi = weight / (height * height);
  let category, cls;
  if (bmi < 18.5) { category = 'Underweight'; cls = 'warn'; }
  else if (bmi < 25) { category = 'Normal'; cls = 'good'; }
  else if (bmi < 30) { category = 'Overweight'; cls = 'warn'; }
  else { category = 'Obese'; cls = 'bad'; }

  const healthyMin = 18.5 * height * height;
  const healthyMax = 24.9 * height * height;
  const healthyMinDisplay = units === 'metric' ? healthyMin.toFixed(1) + ' kg' : (healthyMin / 0.453592).toFixed(1) + ' lbs';
  const healthyMaxDisplay = units === 'metric' ? healthyMax.toFixed(1) + ' kg' : (healthyMax / 0.453592).toFixed(1) + ' lbs';

  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">${bmi.toFixed(1)}</div>
        <div class="result-label">Your BMI</div>
      </div>
      <div class="metric-card">
        <div class="result-number"><span class="status-badge ${cls}">${category}</span></div>
        <div class="result-label">Category</div>
      </div>
      <div class="metric-card">
        <div class="result-number" style="font-size:1.1rem;">${healthyMinDisplay} – ${healthyMaxDisplay}</div>
        <div class="result-label">Healthy weight range</div>
      </div>
    </div>
  `;

  if (gaugeChart) gaugeChart.destroy();
  const pct = Math.min(100, Math.max(0, ((bmi - 10) / 30) * 100));
  gaugeChart = new Chart(document.getElementById('gauge'), {
    type: 'doughnut',
    data: {
      labels: ['BMI', 'Remaining'],
      datasets: [{
        data: [pct, 100 - pct],
        backgroundColor: [cls === 'good' ? '#15803d' : cls === 'warn' ? '#854d0e' : '#991b1b', '#e8e4db'],
        borderWidth: 0,
      }]
    },
    options: { cutout: '75%', responsive: true, plugins: { legend: { display: false } } }
  });
}

document.getElementById('units').addEventListener('change', function() {
  if (this.value === 'metric') {
    document.getElementById('height').value = 175;
    document.getElementById('weight').value = 70;
  } else {
    document.getElementById('height').value = 69;
    document.getElementById('weight').value = 154;
  }
  calculate();
});
['units','height','weight','age','gender'].forEach(id => document.getElementById(id).addEventListener('input', calculate));
calculate();
</script>
