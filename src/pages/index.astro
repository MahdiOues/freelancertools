---
import Page from '../layouts/Page.astro';
import AdZone from '../components/AdZone.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 6);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "megalancer.online",
  "description": "Free tools for freelancers, founders, and small business owners — calculators, generators, and AI-powered helpers.",
  "url": "https://www.megalancer.online/",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "MegaLancer",
  "url": "https://www.megalancer.online",
  "description": "Free calculators and tools for freelancers, founders, and finance professionals.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.megalancer.online/search/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I calculate my freelance rate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Start with your desired annual income, add your business expenses and tax burden, then divide by the number of billable hours you can realistically work in a year. Most freelancers use 1,000 billable hours (roughly 20 hours per week) rather than 2,000, because the rest goes to admin, marketing, and unpaid work. The freelancer rate calculator does this math for you and shows hourly, daily, and project rates."
      }
    },
    {
      "@type": "Question",
      "name": "What is a good hourly rate for a freelancer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "There is no single good rate — it depends on your expenses, target income, and market. A common baseline is to take the salary you want, add 30% for taxes and benefits, and divide by 1,000 billable hours. For example, an $80,000 target works out to roughly $80/hour minimum. The rate calculator factors in your specific costs and compares your rate to industry averages."
      }
    },
    {
      "@type": "Question",
      "name": "How much should I charge for a freelance project?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Estimate the hours each phase of the project will take, multiply by your hourly rate, and add a buffer for revisions and scope creep. A $5,000 website at $100/hour means roughly 50 hours of work. The project estimator breaks your work into phases, estimates hours per phase, and gives you a realistic total to include in your proposal."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate mortgage payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your monthly mortgage payment includes principal, interest, property taxes, homeowners insurance, and PMI if your down payment is under 20%. The standard formula uses the loan amount, interest rate, and loan term to calculate the principal and interest portion. The mortgage calculator gives you the full monthly number including taxes and insurance so you see the real cost, not just the P&I payment."
      }
    },
    {
      "@type": "Question",
      "name": "How long will it take to pay off my debt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your total balance, interest rate, minimum payment, and how much extra you put toward it each month. At the minimum payment, a $10,000 credit card balance at 18% APR takes over 20 years. Adding $100 per month cuts that to roughly 5 years. The debt payoff calculator compares avalanche and snowball strategies so you see exactly how long each debt will take at your chosen payment amount."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate the percentage of a number?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Multiply the number by the percentage expressed as a decimal. To find 15% of $200, multiply 200 by 0.15 to get $30. For the reverse — what percent X is of Y — divide X by Y and multiply by 100. The percentage calculator handles both modes and also does percentage increase and decrease between any two numbers."
      }
    },
    {
      "@type": "Question",
      "name": "How do I convert inches to centimeters?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Multiply inches by 2.54 to get centimeters. A 12-inch ruler is 12 times 2.54, or 30.48 centimeters. Going the other way, divide centimeters by 2.54. The unit converter handles length, weight, temperature, volume, speed, area, and pressure all in one page, plus dedicated conversion pages for the 15 most common unit pairs."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a contract for freelance work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, for every project regardless of size. A one-page contract with scope, payment terms, deadlines, and revision limits prevents disputes and gives you leverage if a client refuses to pay. Without one, you have no written proof of what was agreed. The contract generator builds a freelance contract tailored to your project type, so you have signed terms before you start working."
      }
    }
  ]
};

const categories = [
  { href: '/freelancer/', label: 'Freelancer', icon: '$', accent: 'var(--cat-freelancer)', bg: 'var(--cat-freelancer-bg)', desc: 'Rates, invoices, proposals, project estimates, and late fees.', count: '6 tools' },
  { href: '/finance/', label: 'Finance', icon: '%', accent: 'var(--cat-finance)', bg: 'var(--cat-finance-bg)', desc: 'Debt payoff, mortgages, budgets, taxes, loans, and investing.', count: '23 tools' },
  { href: '/legal/', label: 'Legal', icon: '#', accent: 'var(--cat-legal)', bg: 'var(--cat-legal-bg)', desc: 'Contracts, NDAs, and plain-English contract summaries.', count: '3 tools' },
  { href: '/math/', label: 'Math', icon: '+', accent: 'var(--cat-math)', bg: 'var(--cat-math-bg)', desc: 'Percentages, conversions, dates, GPA, discounts, and time zones.', count: '27 tools' },
  { href: '/health/', label: 'Health', icon: 'H', accent: 'var(--cat-health)', bg: 'var(--cat-health-bg)', desc: 'BMI, TDEE, sleep, water intake, pregnancy, and calories.', count: '6 tools' },
  { href: '/marketing/', label: 'Marketing', icon: 'A', accent: 'var(--cat-marketing)', bg: 'var(--cat-marketing-bg)', desc: 'Ad profit, ROAS, and hook analysis for campaigns.', count: '2 tools' },
  { href: '/saas/', label: 'SaaS', icon: 'S', accent: 'var(--cat-saas)', bg: 'var(--cat-saas-bg)', desc: 'MRR, SaaS pricing, and ROI calculators for founders.', count: '3 tools' },
  { href: '/construction/', label: 'Construction', icon: 'C', accent: 'var(--cat-construction)', bg: 'var(--cat-construction-bg)', desc: 'Concrete and jobsite math calculators for material planning.', count: '2 tools' },
];

const popularTools = [
  { href: '/freelancer/rate-calculator/', title: 'Freelancer Rate Calculator', tag: 'Set your price', desc: 'Find the hourly, daily, and project rate that covers taxes, expenses, and downtime.' },
  { href: '/freelancer/invoice-generator/', title: 'Invoice Generator', tag: 'Get paid', desc: 'Create a clean invoice with payment terms, late-fee language, and PDF-ready formatting.' },
  { href: '/freelancer/late-fee-calculator/', title: 'Late Fee Calculator', tag: 'Overdue invoices', desc: 'Calculate fair late-payment interest and total amount due from any invoice date.' },
  { href: '/finance/debt-payoff/', title: 'Debt Payoff Calculator', tag: 'Cash flow', desc: 'Compare avalanche and snowball payoff plans with extra-payment scenarios.' },
  { href: '/finance/mortgage-calculator/', title: 'Mortgage Calculator', tag: 'Big decisions', desc: 'Estimate payment, taxes, PMI, insurance, and amortization before you buy.' },
  { href: '/legal/contract-generator/', title: 'Contract Generator', tag: 'Client safety', desc: 'Draft a freelance or business contract with scope, milestones, and payment terms.' },
];

const painPoints = [
  { problem: 'I do not know what to charge.', help: 'Use the rate calculator, salary-to-hourly converter, and pricing articles to price from your real costs instead of guessing.', href: '/freelancer/rate-calculator/' },
  { problem: 'Clients pay late or disappear.', help: 'Create clearer invoices, calculate late fees, and follow a calm reminder timeline.', href: '/freelancer/late-fee-calculator/' },
  { problem: 'Projects keep growing after the quote.', help: 'Use contracts, project estimates, milestones, and change-order language before work starts.', href: '/freelancer/project-estimator/' },
  { problem: 'I need quick finance answers.', help: 'Compare loans, budget income, model debt payoff, and estimate taxes without opening a spreadsheet.', href: '/finance/' },
];
---

<Page
  title="Free Tools for Freelancers & Small Business Owners"
  description="Free calculators, contract generators, and AI-powered tools for freelancers, founders, and small business owners. Finance, Legal, SaaS, Marketing, and Freelancer tools."
  canonicalUrl="https://www.megalancer.online/"
  schema={[schema, websiteSchema, faqSchema]}
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-badge">Free calculators, generators, and guides</div>
        <h1>Run the numbers before work gets messy.</h1>
        <p class="hero-sub">MegaLancer helps freelancers, founders, and small business owners price projects, send invoices, compare financial decisions, and protect client work.</p>
        <form class="hero-search" action="/search/" method="get">
          <label class="sr-only" for="home-search">Search tools and guides</label>
          <input id="home-search" name="q" type="search" placeholder="Search rates, invoices, mortgage, debt, contracts..." />
          <button type="submit">Search</button>
        </form>
        <div class="hero-cats" aria-label="Popular shortcuts">
          <a href="/freelancer/rate-calculator/" class="hero-cat-pill" style="--cat: var(--cat-freelancer)">Rate calculator</a>
          <a href="/freelancer/invoice-generator/" class="hero-cat-pill" style="--cat: var(--cat-freelancer)">Invoice generator</a>
          <a href="/finance/debt-payoff/" class="hero-cat-pill" style="--cat: var(--cat-finance)">Debt payoff</a>
          <a href="/legal/contract-generator/" class="hero-cat-pill" style="--cat: var(--cat-legal)">Contract generator</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Common freelance business questions">
        <span class="hero-panel-kicker">Most searched problems</span>
        {painPoints.slice(0, 3).map(item => (
          <a href={item.href} class="hero-problem">
            <strong>{item.problem}</strong>
            <span>{item.help}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="hero-stat-row">
      <div class="hero-stat"><span class="hero-stat-num">50+</span><span class="hero-stat-label">Free tools</span></div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat"><span class="hero-stat-num">8</span><span class="hero-stat-label">Topic hubs</span></div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat"><span class="hero-stat-num">0</span><span class="hero-stat-label">Sign-up needed</span></div>
    </div>
  </section>

  <div class="container">
    <AdZone size="leaderboard" />

    <section class="home-section">
      <div class="section-heading">
        <span class="eyebrow">Start here</span>
        <h2>Tools by category</h2>
        <p>Choose the area you are working on, then jump straight into a calculator or generator.</p>
      </div>
      <div class="home-category-grid">
        {categories.map(cat => (
          <a href={cat.href} class="home-cat-card" style={`--cat-accent:${cat.accent};--cat-bg:${cat.bg};`}>
            <span class="home-cat-icon">{cat.icon}</span>
            <div>
              <h3>{cat.label}</h3>
              <span class="tool-count">{cat.count}</span>
            </div>
            <p>{cat.desc}</p>
            <div class="arrow">Explore</div>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section">
      <div class="section-heading">
        <span class="eyebrow">Fast answers</span>
        <h2>Most useful tools</h2>
        <p>These are the tools that map to common high-intent searches and recurring freelancer pain points.</p>
      </div>
      <div class="featured-tool-grid">
        {popularTools.map(tool => (
          <a href={tool.href} class="featured-tool-card">
            <span>{tool.tag}</span>
            <h3>{tool.title}</h3>
            <p>{tool.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <AdZone size="square" />

    <section class="home-section">
      <div class="section-heading">
        <span class="eyebrow">What people struggle with</span>
        <h2>Practical help for messy business moments</h2>
      </div>
      <div class="pain-grid">
        {painPoints.map(item => (
          <a href={item.href} class="pain-card">
            <h3>{item.problem}</h3>
            <p>{item.help}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section">
      <div class="section-heading">
        <span class="eyebrow">Guides</span>
        <h2>From the blog</h2>
        <p>Step-by-step articles for the questions people ask before they trust a calculator.</p>
      </div>
      <ul class="blog-list home-blog-list">
        {posts.map(post => (
          <li>
            <span class="blog-date">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="blog-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></span>
            <span class="blog-cat">{post.data.category}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-section">
      <div class="section-heading">
        <span class="eyebrow">Quick answers</span>
        <h2>Frequently asked questions</h2>
      </div>
      <details>
        <summary>How do I calculate my freelance rate?</summary>
        <p>Start with your desired annual income, add your business expenses and tax burden, then divide by the number of billable hours you can realistically work in a year. Most freelancers use 1,000 billable hours (roughly 20 hours per week) rather than 2,000, because the rest goes to admin, marketing, and unpaid work. The <a href="/freelancer/rate-calculator/">freelancer rate calculator</a> does this math for you and shows hourly, daily, and project rates.</p>
      </details>
      <details>
        <summary>What is a good hourly rate for a freelancer?</summary>
        <p>There is no single good rate — it depends on your expenses, target income, and market. A common baseline is to take the salary you want, add 30% for taxes and benefits, and divide by 1,000 billable hours. For example, an $80,000 target works out to roughly $80/hour minimum. The <a href="/freelancer/rate-calculator/">rate calculator</a> factors in your specific costs and compares your rate to industry averages.</p>
      </details>
      <details>
        <summary>How much should I charge for a freelance project?</summary>
        <p>Estimate the hours each phase of the project will take, multiply by your hourly rate, and add a buffer for revisions and scope creep. A $5,000 website at $100/hour means roughly 50 hours of work. The <a href="/freelancer/project-estimator/">project estimator</a> breaks your work into phases, estimates hours per phase, and gives you a realistic total to include in your proposal.</p>
      </details>
      <details>
        <summary>How do I calculate mortgage payments?</summary>
        <p>Your monthly mortgage payment includes principal, interest, property taxes, homeowners insurance, and PMI if your down payment is under 20%. The <a href="/finance/mortgage-calculator/">mortgage calculator</a> gives you the full monthly number including taxes and insurance so you see the real cost, not just the principal and interest payment.</p>
      </details>
      <details>
        <summary>How long will it take to pay off my debt?</summary>
        <p>It depends on your total balance, interest rate, minimum payment, and how much extra you put toward it each month. At the minimum payment, a $10,000 credit card balance at 18% APR takes over 20 years. Adding $100 per month cuts that to roughly 5 years. The <a href="/finance/debt-payoff/">debt payoff calculator</a> compares avalanche and snowball strategies so you see exactly how long each debt will take at your chosen payment amount.</p>
      </details>
      <details>
        <summary>How do I calculate the percentage of a number?</summary>
        <p>Multiply the number by the percentage expressed as a decimal. To find 15% of $200, multiply 200 by 0.15 to get $30. For the reverse — what percent X is of Y — divide X by Y and multiply by 100. The <a href="/math/percentage-calculator/">percentage calculator</a> handles both modes and also does percentage increase and decrease between any two numbers.</p>
      </details>
      <details>
        <summary>How do I convert inches to centimeters?</summary>
        <p>Multiply inches by 2.54 to get centimeters. A 12-inch ruler is 12 times 2.54, or 30.48 centimeters. Going the other way, divide centimeters by 2.54. The <a href="/math/unit-converter/">unit converter</a> handles length, weight, temperature, volume, speed, area, and pressure all in one page, plus dedicated conversion pages for the 15 most common unit pairs.</p>
      </details>
      <details>
        <summary>Do I need a contract for freelance work?</summary>
        <p>Yes, for every project regardless of size. A one-page contract with scope, payment terms, deadlines, and revision limits prevents disputes and gives you leverage if a client refuses to pay. The <a href="/legal/contract-generator/">contract generator</a> builds a freelance contract tailored to your project type, so you have signed terms before you start working.</p>
      </details>
    </section>

    <AdZone size="footer" />
  </div>
</Page>
