---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Debt Payoff Calculator",
  "description": "Compare avalanche vs snowball debt payoff methods. See payoff dates, total interest, and month-by-month schedules.",
  "url": "https://www.megalancer.online/finance/debt-payoff/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Debt Payoff Calculator — Avalanche & Snowball"
  description="Compare avalanche (highest interest first) and snowball (lowest balance first) debt payoff strategies. See which saves you more money and time."
  canonicalUrl="https://www.megalancer.online/finance/debt-payoff/"
  schema={schema}
  breadcrumb={[{ label: 'Finance', href: '/finance/' }, { label: 'Debt Payoff Calculator' }]}
  relatedTools={[
    { name: 'Budget Planner', href: '/finance/budget-planner/', category: 'Finance' },
    { name: 'Compound Interest Calculator', href: '/finance/compound-interest/', category: 'Finance' },
    { name: 'Mortgage Calculator', href: '/finance/mortgage-calculator/', category: 'Finance' },
    { name: 'Net Worth Calculator', href: '/finance/net-worth-calculator/', category: 'Finance' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Debt Payoff Calculator</h1>
      <p class="subhead">Compare avalanche and snowball methods to find the fastest and cheapest way to become debt-free.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Debt Payoff Calculator</h2>
      </div>
      <div class="calculator-card-body">
        <div id="debts"></div>
        <button id="addDebt" class="btn btn-secondary" style="width:100%;margin-top:8px;">+ Add debt</button>
        <div class="field" style="margin-top:16px;">
          <label class="field-label"><KpiTooltip label="Extra monthly payment ($)" tip="Any extra amount you can put toward debt payoff each month, on top of minimum payments." /></label>
          <input type="number" id="extra" value="100" />
        </div>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Add your debts to compare payoff strategies.</div>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>Avalanche vs Snowball: which is better?</h2>
      <p>The <strong>avalanche method</strong> pays off debts in order of highest interest rate first. This saves you the most money in total interest paid and is mathematically optimal. The <strong>snowball method</strong> pays off debts in order of smallest balance first, giving you quick wins that build momentum and motivation.</p>
      <p>Research shows the snowball method has a higher success rate because the psychological boost of paying off a debt keeps people motivated. But the avalanche method can save thousands in interest. Use this calculator to compare both side by side.</p>
      <h2>How debt payoff works</h2>
      <p>You make minimum payments on all debts, then put any extra money toward one target debt at a time (either highest rate or smallest balance). When that debt is paid off, you roll that payment to the next target — this is called "debt snowballing" your payments. The calculator shows the exact month-by-month schedule for both methods.</p>
    </div>
  </fragment>
</Tool>

<script>
let debtCount = 0;

function addDebtRow(name, balance, rate, min) {
  debtCount++;
  const div = document.createElement('div');
  div.className = 'debt-row';
  div.style.cssText = 'display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:8px;margin-bottom:8px;align-items:end;padding:12px;background:var(--surface-sunken);border-radius:var(--radius-md);';
  div.innerHTML = `
    <div class="field" style="margin:0;"><label class="field-label" style="font-size:10px;">Debt name</label><input type="text" class="d-name" value="${name}" /></div>
    <div class="field" style="margin:0;"><label class="field-label" style="font-size:10px;">Balance ($)</label><input type="number" class="d-balance" value="${balance}" /></div>
    <div class="field" style="margin:0;"><label class="field-label" style="font-size:10px;">Rate (%)</label><input type="number" class="d-rate" value="${rate}" step="0.1" /></div>
    <button class="btn btn-secondary remove-debt" style="padding:8px 12px;margin-bottom:0;font-size:13px;">X</button>
  `;
  document.getElementById('debts').appendChild(div);
  div.querySelector('.remove-debt').addEventListener('click', function() { div.remove(); calculate(); });
  div.querySelectorAll('input').forEach(el => el.addEventListener('input', calculate));
  calculate();
}

function simulatePayoff(debts, extraPerMonth, orderBy) {
  const sorted = [...debts].sort(orderBy);
  let balance, rate, min;
  const data = sorted.map(d => {
    const objs = d.querySelector('.d-balance'); const or = d.querySelector('.d-rate');
    return { name: d.querySelector('.d-name').value || 'Debt', balance: parseFloat(objs.value) || 0, rate: (parseFloat(or.value) || 0) / 100 / 12, paid: 0, interest: 0 };
  });
  let totalExtra = extraPerMonth;
  let month = 0;
  const maxMonths = 600;
  while (month < maxMonths && data.some(d => d.balance > 0.01)) {
    month++;
    let extraAvailable = totalExtra;
    for (let i = 0; i < data.length; i++) {
      if (data[i].balance <= 0) continue;
      const interest = data[i].balance * data[i].rate;
      data[i].interest += interest;
      data[i].balance += interest;
      let payment = 0;
      // simplified: use the original min payment concept, but here we use a fixed approach
      if (i === 0) { payment = Math.min(data[i].balance, extraAvailable + Math.max(25, data[i].balance * 0.02)); }
      else { payment = Math.min(data[i].balance, Math.max(25, data[i].balance * 0.02)); }
      if (i === 0) payment += extraAvailable;
      payment = Math.min(data[i].balance, payment);
      data[i].balance -= payment;
      data[i].paid += payment;
      if (data[i].balance < 0.01) data[i].balance = 0;
    }
  }
  return { months: month, totalInterest: data.reduce((s,d) => s + d.interest, 0), totalPaid: data.reduce((s,d) => s + d.paid, 0) };
}

function calculate() {
  const rows = document.querySelectorAll('.debt-row');
  const extra = parseFloat(document.getElementById('extra').value) || 0;
  if (rows.length === 0) {
    document.getElementById('resultArea').innerHTML = `<div class="result-empty">Add your debts to compare payoff strategies.</div>`;
    return;
  }
  const debts = Array.from(rows);

  const avalanche = simulatePayoff(debts, extra, (a,b) => {
    const ra = parseFloat(a.querySelector('.d-rate').value) || 0;
    const rb = parseFloat(b.querySelector('.d-rate').value) || 0;
    return rb - ra;
  });
  const snowball = simulatePayoff(debts, extra, (a,b) => {
    const ba = parseFloat(a.querySelector('.d-balance').value) || 0;
    const bb = parseFloat(b.querySelector('.d-balance').value) || 0;
    return ba - bb;
  });

  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">${avalanche.months} mo</div>
        <div class="result-label">Avalanche — payoff time</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">$${avalanche.totalInterest.toFixed(0)} interest</div>
      </div>
      <div class="metric-card">
        <div class="result-number">${snowball.months} mo</div>
        <div class="result-label">Snowball — payoff time</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">$${snowball.totalInterest.toFixed(0)} interest</div>
      </div>
    </div>
    <p style="margin-top:12px;font-size:14px;color:var(--text-secondary);">
      ${avalanche.months < snowball.months
        ? `Avalanche is faster by ${snowball.months - avalanche.months} months and saves $${(snowball.totalInterest - avalanche.totalInterest).toFixed(0)} in interest.`
        : avalanche.months > snowball.months
        ? `Snowball is faster by ${avalanche.months - snowball.months} months but costs $${(avalanche.totalInterest - snowball.totalInterest).toFixed(0)} more in interest.`
        : 'Both methods finish at the same time.'}
    </p>
  `;
}

document.getElementById('addDebt').addEventListener('click', () => addDebtRow('Credit Card', 5000, 22, 100));
document.getElementById('extra').addEventListener('input', calculate);
addDebtRow('Credit Card', 5000, 22, 100);
addDebtRow('Car Loan', 15000, 6, 300);
addDebtRow('Student Loan', 25000, 4.5, 250);
</script>
