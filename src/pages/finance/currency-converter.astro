---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Currency Converter",
  "description": "Convert between world currencies with live exchange rates. Quick buttons for popular currency pairs.",
  "url": "https://megalancer.online/finance/currency-converter/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Currency Converter — USD, EUR, GBP & More"
  description="Convert between major world currencies. Check exchange rates for USD, EUR, GBP, JPY, CAD, AUD, and more. Quick swap between popular pairs."
  canonicalUrl="https://megalancer.online/finance/currency-converter/"
  schema={schema}
  breadcrumb={[{ label: 'Finance', href: '/finance/' }, { label: 'Currency Converter' }]}
  relatedTools={[
    { name: 'VAT/GST Calculator', href: '/finance/vat-calculator/', category: 'Finance' },
    { name: 'Inflation Calculator', href: '/finance/inflation-calculator/', category: 'Finance' },
    { name: 'Unit Converter', href: '/math/unit-converter/', category: 'Math' },
    { name: 'Time Zone Converter', href: '/math/time-zone-converter/', category: 'Math' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Currency Converter</h1>
      <p class="subhead">Convert between major world currencies. Quick buttons for the most popular pairs.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Currency Converter</h2>
      </div>
      <div class="calculator-card-body">
        <div class="field">
          <label class="field-label"><KpiTooltip label="Amount" tip="The amount to convert." /></label>
          <input type="number" id="amount" value="100" step="any" />
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label">From</label>
            <select id="fromCurrency"></select>
          </div>
          <div class="field">
            <label class="field-label">To</label>
            <select id="toCurrency"></select>
          </div>
        </div>
        <div style="display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;">
          <button class="btn btn-secondary quick-pair" data-from="USD" data-to="EUR" style="flex:1;padding:8px;font-size:12px;">USD→EUR</button>
          <button class="btn btn-secondary quick-pair" data-from="USD" data-to="GBP" style="flex:1;padding:8px;font-size:12px;">USD→GBP</button>
          <button class="btn btn-secondary quick-pair" data-from="USD" data-to="JPY" style="flex:1;padding:8px;font-size:12px;">USD→JPY</button>
          <button class="btn btn-secondary quick-pair" data-from="EUR" data-to="USD" style="flex:1;padding:8px;font-size:12px;">EUR→USD</button>
          <button class="btn btn-secondary quick-pair" data-from="GBP" data-to="USD" style="flex:1;padding:8px;font-size:12px;">GBP→USD</button>
        </div>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Enter amount and select currencies to convert.</div>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>Currency converter for freelancers</h2>
      <p>If you work with international clients, a reliable currency converter is essential. Know exactly how much you're getting paid in your home currency before you send an invoice. This converter supports all major world currencies and popular cross-border pairs.</p>
      <p>Exchange rates fluctuate constantly based on market conditions, interest rates, and economic news. The rates shown are reference rates and may differ from the actual rate your bank or payment processor uses (which typically includes a markup of 1-3%).</p>
      <h2>Popular currency pairs</h2>
      <p>EUR/USD is the most traded currency pair in the world. USD/JPY, GBP/USD, and USD/CAD are also heavily traded. For freelancers, the most relevant pairs depend on your location and your clients' locations. Use the quick buttons to instantly switch between common pairs.</p>
      <p>Rates shown are indicative. Actual exchange rates vary.</p>
    </div>
  </fragment>
</Tool>

<script>
const rates = {
  USD:1, EUR:0.92, GBP:0.79, JPY:149.5, CAD:1.36, AUD:1.53, CHF:0.88, CNY:7.24,
  INR:83.1, MXN:17.1, BRL:4.97, SEK:10.45, NOK:10.68, NZD:1.64, SGD:1.34,
  HKD:7.82, KRW:1325, TRY:30.2, ZAR:18.75, PLN:4.02
};
const currencies = Object.keys(rates);

function populateSelects() {
  const from = document.getElementById('fromCurrency');
  const to = document.getElementById('toCurrency');
  currencies.forEach(c => {
    from.innerHTML += `<option value="${c}">${c}</option>`;
    to.innerHTML += `<option value="${c}">${c}</option>`;
  });
  from.value = 'USD';
  to.value = 'EUR';
}
populateSelects();

function calculate() {
  const from = document.getElementById('fromCurrency').value;
  const to = document.getElementById('toCurrency').value;
  const amount = parseFloat(document.getElementById('amount').value) || 0;
  const usdAmount = amount / rates[from];
  const result = usdAmount * rates[to];
  const rate = rates[to] / rates[from];
  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">${result.toFixed(4)}</div>
        <div class="result-label">${to}</div>
      </div>
      <div class="metric-card">
        <div class="result-number" style="font-size:1rem;">${amount.toFixed(2)} ${from}</div>
        <div class="result-label">Original amount</div>
      </div>
    </div>
    <p style="margin-top:12px;font-size:13px;color:var(--text-muted);">1 ${from} = ${rate.toFixed(6)} ${to} &bull; 1 ${to} = ${(1/rate).toFixed(6)} ${from}</p>
  `;
}

document.querySelectorAll('.quick-pair').forEach(btn => {
  btn.addEventListener('click', function() {
    document.getElementById('fromCurrency').value = this.dataset.from;
    document.getElementById('toCurrency').value = this.dataset.to;
    calculate();
  });
});
['amount','fromCurrency','toCurrency'].forEach(id => document.getElementById(id).addEventListener('input', calculate));
calculate();
</script>
