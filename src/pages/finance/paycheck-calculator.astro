---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Paycheck Calculator",
  "description": "Calculate your take-home pay after federal and state taxes. Supports salary and hourly with all 50 state tax rates.",
  "url": "https://megalancer.online/finance/paycheck-calculator/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Paycheck Calculator — Take-Home Pay"
  description="Calculate your net pay after federal income tax, FICA, and state tax. Supports salary and hourly pay with 2024/2025 tax brackets."
  canonicalUrl="https://megalancer.online/finance/paycheck-calculator/"
  schema={schema}
  breadcrumb={[{ label: 'Finance', href: '/finance/' }, { label: 'Paycheck Calculator' }]}
  relatedTools={[
    { name: 'Salary to Hourly Calculator', href: '/freelancer/salary-to-hourly/', category: 'Freelancer' },
    { name: 'Budget Planner', href: '/finance/budget-planner/', category: 'Finance' },
    { name: 'Retirement Calculator', href: '/finance/retirement-calculator/', category: 'Finance' },
    { name: 'Net Worth Calculator', href: '/finance/net-worth-calculator/', category: 'Finance' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Paycheck Calculator</h1>
      <p class="subhead">See your take-home pay after federal, FICA, and state taxes. Estimate your net paycheck for any pay frequency.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Paycheck Calculator</h2>
      </div>
      <div class="calculator-card-body">
        <div class="field">
          <label class="field-label">Pay type</label>
          <select id="payType">
            <option value="salary">Salary</option>
            <option value="hourly">Hourly</option>
          </select>
        </div>
        <div id="salaryField">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Annual salary ($)" tip="Your gross annual salary." /></label>
            <input type="number" id="salary" value="75000" />
          </div>
        </div>
        <div id="hourlyField" style="display:none;">
          <div class="field-grid">
            <div class="field">
              <label class="field-label"><KpiTooltip label="Hourly rate ($)" tip="Your hourly wage." /></label>
              <input type="number" id="hourlyRate" value="35" step="0.5" />
            </div>
            <div class="field">
              <label class="field-label"><KpiTooltip label="Hours/week" tip="Hours worked per week." /></label>
              <input type="number" id="hoursPerWeek" value="40" />
            </div>
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Pay frequency" tip="How often you get paid." /></label>
            <select id="payFreq">
              <option value="weekly">Weekly (52/year)</option>
              <option value="biweekly" selected>Biweekly (26/year)</option>
              <option value="semimonthly">Semi-monthly (24/year)</option>
              <option value="monthly">Monthly (12/year)</option>
            </select>
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Filing status" tip="Your tax filing status." /></label>
            <select id="filingStatus">
              <option value="single">Single</option>
              <option value="married">Married filing jointly</option>
              <option value="head">Head of household</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label class="field-label">State</label>
          <select id="state"></select>
        </div>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Enter your pay details to calculate net pay.</div>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>How your paycheck is calculated</h2>
      <p>Your gross pay is reduced by three main types of taxes: federal income tax (using progressive brackets), Social Security and Medicare (FICA — 7.65% total), and state income tax (varies by state, from 0% in Texas to 13.3% in California). Your net pay is what's left after all deductions.</p>
      <p>This calculator uses 2024/2025 federal tax brackets and includes all 50 states' income tax rates (or zero for states with no income tax). It estimates federal tax using the standard deduction and simplifies withholding calculations. For exact amounts, consult your payroll department or tax professional.</p>
      <h2>Understanding withholding</h2>
      <p>Your employer withholds taxes from each paycheck based on the W-4 form you filled out. If too little is withheld, you owe at tax time. If too much, you get a refund. This calculator helps you estimate your per-paycheck withholding so you can adjust your W-4 if needed.</p>
      <p>This is an estimate. Actual results vary.</p>
      <div class="sources">
        <h3>Sources</h3>
        <ul>
          <li><a href="https://www.irs.gov/pub/irs-pdf/p15t.pdf" rel="nofollow noopener" target="_blank">IRS Publication 15-T — Federal Income Tax Withholding Methods</a></li>
          <li><a href="https://www.ssa.gov/oact/cola/cbb.html" rel="nofollow noopener" target="_blank">Social Security Administration — Contribution and Benefit Base</a></li>
          <li>State tax rates sourced from each state's department of revenue (2025)</li>
        </ul>
      </div>
    </div>
  </fragment>
</Tool>

<script>
const stateTax = {
  AL:5.0, AK:0.0, AZ:2.5, AR:4.9, CA:13.3, CO:4.4, CT:6.99, DE:6.6, FL:0.0, GA:5.75,
  HI:11.0, ID:5.8, IL:4.95, IN:3.15, IA:6.0, KS:5.7, KY:4.5, LA:4.25, ME:7.15, MD:5.75,
  MA:5.0, MI:4.25, MN:9.85, MS:5.0, MO:4.95, MT:6.75, NE:6.84, NV:0.0, NH:0.0, NJ:10.75,
  NM:5.9, NY:10.9, NC:4.75, ND:2.9, OH:3.99, OK:4.75, OR:9.9, PA:3.07, RI:5.99, SC:7.0,
  SD:0.0, TN:0.0, TX:0.0, UT:4.95, VT:8.75, VA:5.75, WA:0.0, WV:6.5, WI:7.65, WY:0.0
};

const fedBrackets = {
  single: [[0,11600,10],[11600,47150,12],[47150,100525,22],[100525,191950,24],[191950,243725,32],[243725,609350,35],[609350,Infinity,37]],
  married: [[0,23200,10],[23200,94300,12],[94300,201050,22],[201050,383900,24],[383900,487450,32],[487450,731200,35],[731200,Infinity,37]],
  head: [[0,16550,10],[16550,63100,12],[63100,100500,22],[100500,191950,24],[191950,243700,32],[243700,609350,35],[609350,Infinity,37]]
};
const stdDeduction = { single: 14600, married: 29200, head: 21900 };

function populateStates() {
  const sel = document.getElementById('state');
  Object.entries(stateTax).forEach(([code, rate]) => {
    sel.innerHTML += `<option value="${code}">${code} — ${rate > 0 ? rate + '%' : 'No income tax'}</option>`;
  });
  sel.value = 'CA';
}
populateStates();

function calcFedTax(income, status) {
  const ded = stdDeduction[status];
  const taxable = Math.max(0, income - ded);
  let tax = 0;
  const brackets = fedBrackets[status];
  for (const [min, max, rate] of brackets) {
    if (taxable > min) {
      const inBracket = Math.min(taxable, max) - min;
      tax += inBracket * rate / 100;
    }
  }
  return tax;
}

function calculate() {
  const type = document.getElementById('payType').value;
  const freq = document.getElementById('payFreq').value;
  const status = document.getElementById('filingStatus').value;
  const state = document.getElementById('state').value;
  const stateRate = stateTax[state] || 0;

  let annual = 0;
  if (type === 'salary') {
    annual = parseFloat(document.getElementById('salary').value) || 0;
  } else {
    const rate = parseFloat(document.getElementById('hourlyRate').value) || 0;
    const hours = parseFloat(document.getElementById('hoursPerWeek').value) || 40;
    annual = rate * hours * 52;
  }

  const fedTax = calcFedTax(annual, status);
  const fica = annual * 0.0765;
  const stateTaxAmount = annual * (stateRate / 100);
  const totalTax = fedTax + fica + stateTaxAmount;
  const netAnnual = annual - totalTax;

  const freqMap = { weekly: 52, biweekly: 26, semimonthly: 24, monthly: 12 };
  const perFreq = freqMap[freq];

  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">$${(netAnnual / perFreq).toFixed(2)}</div>
        <div class="result-label">Net per ${freq}</div>
      </div>
      <div class="metric-card">
        <div class="result-number">$${(annual / perFreq).toFixed(2)}</div>
        <div class="result-label">Gross per ${freq}</div>
      </div>
      <div class="metric-card">
        <div class="result-number" style="color:var(--danger);">$${((fedTax + fica + stateTaxAmount) / perFreq).toFixed(2)}</div>
        <div class="result-label">Total tax per ${freq}</div>
      </div>
    </div>
    <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--border-light);">
      <table style="width:100%;border-collapse:collapse;font-size:14px;">
        <tr><td style="padding:6px 0;">Federal income tax</td><td style="text-align:right;font-weight:600;">$${fedTax.toFixed(2)}</td><td style="text-align:right;color:var(--text-muted);">${(fedTax/annual*100).toFixed(1)}%</td></tr>
        <tr><td style="padding:6px 0;">FICA (Social Security + Medicare)</td><td style="text-align:right;font-weight:600;">$${fica.toFixed(2)}</td><td style="text-align:right;color:var(--text-muted);">7.65%</td></tr>
        <tr><td style="padding:6px 0;">State income tax (${state})</td><td style="text-align:right;font-weight:600;">$${stateTaxAmount.toFixed(2)}</td><td style="text-align:right;color:var(--text-muted);">${stateRate}%</td></tr>
        <tr style="border-top:2px solid var(--border);"><td style="padding:8px 0;font-weight:700;">Net annual income</td><td style="text-align:right;font-weight:700;">$${netAnnual.toFixed(2)}</td><td></td></tr>
      </table>
    </div>
  `;
}

document.getElementById('payType').addEventListener('change', function() {
  const isSalary = this.value === 'salary';
  document.getElementById('salaryField').style.display = isSalary ? '' : 'none';
  document.getElementById('hourlyField').style.display = isSalary ? 'none' : '';
  calculate();
});
['payType','salary','hourlyRate','hoursPerWeek','payFreq','filingStatus','state'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('input', calculate);
});
calculate();
</script>
