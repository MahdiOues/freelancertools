---
import Tool from '../../../layouts/ToolWithExcel.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Budget vs Actual Variance Analysis Tool",
  "description": "Paste your budget and actual figures to instantly calculate variance in dollars and percentage. Get a colour-coded comparison chart and export to Excel or PDF.",
  "url": "https://freelancertools.io/finance/excel-tools/budget-variance/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I analyse revenue variance as well as expense variance?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. The tool works for any numeric comparison — revenue, headcount, units, or any other metric. Label your rows appropriately and the variance calculation applies the same way." }
    },
    {
      "@type": "Question",
      "name": "How do I handle categories that were not budgeted?",
      "acceptedAnswer": { "@type": "Answer", "text": "Enter 0 as the Budget value. The tool will show a 100% unfavourable variance, which accurately reflects unplanned spend." }
    },
    {
      "@type": "Question",
      "name": "What counts as On target?",
      "acceptedAnswer": { "@type": "Answer", "text": "Lines within +/-5% of budget are labelled On target. Lines more than 5% over are labelled Over budget and lines more than 5% under are labelled Under budget." }
    },
    {
      "@type": "Question",
      "name": "Can I compare more than two periods?",
      "acceptedAnswer": { "@type": "Answer", "text": "This tool compares one budget column against one actual column. For multi-period comparisons, use the Chart Builder tool and select multiple value columns." }
    },
    {
      "@type": "Question",
      "name": "Is there a limit on the number of line items?",
      "acceptedAnswer": { "@type": "Answer", "text": "No hard limit. The chart becomes harder to read beyond about 20 categories — for large budgets, consider grouping sub-categories before pasting." }
    }
  ]
};
---

<Tool
  title="Budget vs Actual Variance Analyzer"
  description="Paste your budget and actual figures to instantly calculate variance in dollars and percentage. Get a colour-coded comparison chart and export to Excel or PDF. No Excel knowledge needed."
  canonicalUrl="https://freelancertools.io/finance/excel-tools/budget-variance/"
  schema={schema}
  breadcrumb={[{ label: 'Finance', href: '/finance/' }, { label: 'Excel-Free Tools', href: '/finance/excel-tools/' }, { label: 'Budget vs Actual' }]}
  relatedTools={[
    { name: 'Chart Builder', href: '/finance/excel-tools/chart-builder/', category: 'Finance' },
    { name: 'Cash Flow Waterfall', href: '/finance/excel-tools/cash-flow-waterfall/', category: 'Finance' },
    { name: 'Pivot Summarizer', href: '/finance/excel-tools/pivot-summarizer/', category: 'Finance' },
    { name: 'Financial Ratios', href: '/finance/excel-tools/financial-ratios/', category: 'Finance' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Free Budget vs Actual Variance Analysis — Instant Financial Comparison</h1>
      <p class="subhead">Paste or upload a budget and actual spend side by side. Instantly see variance ($), variance (%), and a color-coded bar chart.</p>
    </div>
  </fragment>
  <div class="tool-intro" style="max-width:720px;margin:0 auto 28px;">
    <p>Paste your budget and actual figures into the tool and instantly see the variance for every line item — in both dollars and percentage. The tool generates a grouped bar chart comparing budget to actual across all categories and flags items that are over or under budget. Used by finance teams, accountants, and business owners who need variance analysis without building it manually in Excel. Export results as Excel or PDF in one click.</p>
  </div>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Budget vs Actual Variance Analyzer</h2>
      </div>
      <div class="calculator-card-body">
      <div class="upload-zone" id="uploadZone">
        <input type="file" id="fileInput" accept=".csv,.xlsx,.xls" />
        <p style="font-weight:600;color:var(--ink);margin-bottom:4px;">Upload CSV or Excel file</p>
        <p style="font-size:13px;color:var(--ink-3);">or paste budget data below</p>
      </div>
      <div style="margin:12px 0;">
        <textarea id="pasteArea" rows="6" placeholder="Category, Budget, Actual&#10;Salaries, 50000, 52000&#10;Marketing, 12000, 9800&#10;Rent, 8000, 8000&#10;Software, 3000, 4100" style="font-family:monospace;font-size:13px;"></textarea>
      </div>
      <div id="loadBadge" style="display:none;font-size:13px;color:var(--success);font-weight:600;margin-bottom:12px;"></div>
      <button class="btn btn-primary btn-full" id="analyzeBtn">Analyze Variance</button>

      <div style="margin-top:24px;">
        <canvas id="chartCanvas" style="max-height:350px;"></canvas>
      </div>

      <div id="tableWrap" style="margin-top:24px;overflow-x:auto;display:none;">
        <table id="varianceTable" style="width:100%;border-collapse:collapse;font-size:13px;"></table>
      </div>

      <div id="exportRow" style="display:none;margin-top:16px;display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn btn-secondary" onclick="exportTableXLSX('varianceTable','budget_variance.xlsx')">Export as Excel</button>
        <button class="btn btn-primary" onclick="exportPDF('Budget vs Actual Variance','varianceTable','chartCanvas')">Export as PDF</button>
      </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>What is budget variance analysis?</h2>
      <p>Budget variance analysis compares the amounts you planned to spend (budget) against what you actually spent. A positive variance on a revenue line means you outperformed — you brought in more than expected. A positive variance on an expense line means you overspent. Finance teams run this analysis monthly, quarterly, and annually to track performance against plan. It is one of the most common FP&A tasks and is the foundation of management reporting.</p>
      <p>The tool calculates both the absolute dollar variance and the variance percentage, so you can see not just how much you were over or under but also the relative magnitude. A $5,000 variance on a $100,000 line item (5%) is very different from a $5,000 variance on a $10,000 line item (50%).</p>

      <h2>How to read the variance chart</h2>
      <p>The grouped bar chart shows each category side by side — the blue bar is your budget, the red bar is your actual. The table beneath the chart gives you the exact dollar and percentage variance for every row. Categories are colour-coded: green for under budget (favourable), red for over budget (unfavourable), and grey for on target. Sort the table by Variance % descending to find the items that deviated most from plan.</p>

      <h2>What input format does the tool accept?</h2>
      <p>The tool expects three columns: Category, Budget, and Actual. You can paste this data directly from Excel or Google Sheets — the tab-separated values copy across automatically. Alternatively, upload a .csv or .xlsx file. Dollar signs and commas are stripped during parsing, so formatted accounting values work without modification.</p>

      <h2>Exporting variance reports for management review</h2>
      <p>The Excel export includes the full variance table with conditional formatting — over-budget items are highlighted in red, under-budget items in green. The PDF export includes the chart and the table on a single page, with a totals row at the bottom showing the net variance across all categories. Both exports are generated in your browser and ready to attach to a management report.</p>

      <h2>Frequently asked questions</h2>
      <div class="faq-item">
        <h3>Can I analyse revenue variance as well as expense variance?</h3>
        <p>Yes. The tool works for any numeric comparison — revenue, headcount, units, or any other metric. Label your rows appropriately and the variance calculation applies the same way.</p>
      </div>
      <div class="faq-item">
        <h3>How do I handle categories that were not budgeted?</h3>
        <p>Enter 0 as the Budget value. The tool will show a 100% unfavourable variance, which accurately reflects unplanned spend.</p>
      </div>
      <div class="faq-item">
        <h3>What counts as On target?</h3>
        <p>Lines within +/-5% of budget are labelled On target. Lines more than 5% over are labelled Over budget and lines more than 5% under are labelled Under budget.</p>
      </div>
      <div class="faq-item">
        <h3>Can I compare more than two periods?</h3>
        <p>This tool compares one budget column against one actual column. For multi-period comparisons, use the Chart Builder tool and select multiple value columns.</p>
      </div>
      <div class="faq-item">
        <h3>Is there a limit on the number of line items?</h3>
        <p>No hard limit. The chart becomes harder to read beyond about 20 categories — for large budgets, consider grouping sub-categories before pasting.</p>
      </div>

      <h2>Related tools</h2>
      <ul>
        <li><a href="/finance/excel-tools/cash-flow-waterfall/">Cash Flow Waterfall Chart</a></li>
        <li><a href="/finance/excel-tools/pivot-summarizer/">Pivot Table Summariser</a></li>
        <li><a href="/finance/excel-tools/financial-ratios/">Financial Ratio Calculator</a></li>
        <li><a href="/finance/">Back to Finance Tools</a></li>
      </ul>
    </div>
  </fragment>
</Tool>

<script is:inline src="/scripts/excel-tools-core.js"></script>
<script>
(function () {
  let data = [];

  const zone = document.getElementById('uploadZone');
  const fileInput = document.getElementById('fileInput');
  const pasteArea = document.getElementById('pasteArea');
  const loadBadge = document.getElementById('loadBadge');
  const analyzeBtn = document.getElementById('analyzeBtn');
  const tableWrap = document.getElementById('tableWrap');
  const varianceTable = document.getElementById('varianceTable');
  const exportRow = document.getElementById('exportRow');

  function handleFile(file) {
    readFile(file, (json) => {
      data = json;
      loadBadge.style.display = 'block';
      loadBadge.textContent = '\u2713 ' + data.length + ' rows loaded';
    });
  }

  function handlePaste() {
    const text = pasteArea.value.trim();
    if (!text) return;
    data = parseText(text);
    loadBadge.style.display = 'block';
    loadBadge.textContent = '\u2713 ' + data.length + ' rows loaded';
  }

  function analyzeVariance() {
    if (!data.length) return;

    const results = data.map(row => {
      const budget = parseFloat(row['Budget']) || 0;
      const actual = parseFloat(row['Actual']) || 0;
      const varAbs = actual - budget;
      const varPct = budget !== 0 ? (varAbs / budget) * 100 : 0;
      const status = varAbs > 0 ? 'Over' : varAbs < 0 ? 'Under' : 'On Target';
      return {
        Category: row['Category'],
        Budget: fmtCurrency(budget),
        Actual: fmtCurrency(actual),
        'Variance ($)': fmtCurrency(varAbs),
        'Variance (%)': fmtPct(varPct),
        Status: status
      };
    });

    const totalBudget = data.reduce((s, r) => s + (parseFloat(r['Budget']) || 0), 0);
    const totalActual = data.reduce((s, r) => s + (parseFloat(r['Actual']) || 0), 0);
    const totalVar = totalActual - totalBudget;

    tableWrap.style.display = 'block';
    const headers = ['Category','Budget','Actual','Variance ($)','Variance (%)','Status'];
    let html = '<thead><tr>' + headers.map(h => '<th style="text-align:left;padding:8px;border-bottom:2px solid #1a1a1a;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;">' + h + '</th>').join('') + '</tr></thead><tbody>';
    results.forEach(r => {
      const statusClass = r.Status === 'Over' ? 'style="color:var(--danger);font-weight:600;"' : r.Status === 'Under' ? 'style="color:var(--success);font-weight:600;"' : '';
      html += '<tr>' + headers.map(h => {
        if (h === 'Status') return '<td style="padding:8px;border-bottom:1px solid #e8e8e4;"><span class="status-badge ' + (r.Status === 'Over' ? 'bad' : r.Status === 'Under' ? 'good' : 'warn') + '">' + r.Status + '</span></td>';
        return '<td style="padding:8px;border-bottom:1px solid #e8e8e4;">' + r[h] + '</td>';
      }).join('') + '</tr>';
    });
    html += '<tr style="border-top:2px solid #1a1a1a;font-weight:700;">' + headers.map(h => {
      if (h === 'Category') return '<td style="padding:8px;">Total</td>';
      if (h === 'Budget') return '<td style="padding:8px;">' + fmtCurrency(totalBudget) + '</td>';
      if (h === 'Actual') return '<td style="padding:8px;">' + fmtCurrency(totalActual) + '</td>';
      if (h === 'Variance ($)') return '<td style="padding:8px;' + (totalVar > 0 ? 'color:var(--danger);' : totalVar < 0 ? 'color:var(--success);' : '') + '">' + fmtCurrency(totalVar) + '</td>';
      if (h === 'Variance (%)') return '<td style="padding:8px;">' + fmtPct(totalBudget !== 0 ? (totalVar / totalBudget) * 100 : 0) + '</td>';
      if (h === 'Status') return '<td style="padding:8px;"></td>';
      return '<td style="padding:8px;"></td>';
    }).join('') + '</tr>';
    html += '</tbody>';
    varianceTable.innerHTML = html;

    const categories = data.map(r => r['Category']);
    const budgets = data.map(r => parseFloat(r['Budget']) || 0);
    const actuals = data.map(r => parseFloat(r['Actual']) || 0);

    const ctx = document.getElementById('chartCanvas').getContext('2d');
    if (window._chartInstance) window._chartInstance.destroy();
    window._chartInstance = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: categories,
        datasets: [
          { label: 'Budget', data: budgets, backgroundColor: 'rgba(37,99,235,0.8)', borderColor: '#2563eb', borderWidth: 1 },
          { label: 'Actual', data: actuals, backgroundColor: actuals.map((a, i) => a > budgets[i] ? 'rgba(220,38,38,0.8)' : 'rgba(5,150,105,0.8)'), borderColor: actuals.map((a, i) => a > budgets[i] ? '#dc2626' : '#059669'), borderWidth: 1 }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: { x: { grid: { color: '#f0f0ec' } }, y: { grid: { color: '#f0f0ec' }, beginAtZero: true } }
      }
    });

    exportRow.style.display = 'flex';
  }

  fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFile(fileInput.files[0]); });
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) handleFile(file);
  });
  zone.addEventListener('click', () => fileInput.click());
  pasteArea.addEventListener('input', handlePaste);
  analyzeBtn.addEventListener('click', analyzeVariance);
})();
</script>

