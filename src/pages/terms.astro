---
import Page from '../layouts/Page.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Use",
  "url": "https://www.megalancer.online/terms/"
};
---

<Page
  title="Terms of Use"
  description="Terms of Use for MegaLancer, including tool usage, no professional advice, accuracy, intellectual property, and limitation of liability."
  canonicalUrl="https://www.megalancer.online/terms/"
  schema={schema}
>
  <article class="policy-page">
    <h1>Terms of Use</h1>
    <p class="last-updated">Last updated: May 16, 2026</p>

    <h2>Use of tools</h2>
    <p>MegaLancer provides calculators and document generators for informational purposes only. Results are estimates. Do not make financial, legal, medical, or tax decisions based solely on results from this site.</p>

    <h2>No professional advice</h2>
    <p>Nothing on MegaLancer constitutes financial advice, legal advice, medical advice, or tax advice. Consult a licensed professional for your specific situation.</p>

    <h2>Accuracy</h2>
    <p>We make reasonable efforts to keep formulas accurate and up to date. Tax brackets, rates, and regulations change. Always verify critical figures with official sources such as IRS.gov, SSA.gov, or your state tax authority.</p>

    <h2>Intellectual property</h2>
    <p>The tools and content on MegaLancer are original work. You may link to any page. You may embed calculators using the provided embed codes. You may not scrape or reproduce content in bulk without permission.</p>

    <h2>Limitation of liability</h2>
    <p>MegaLancer is provided as-is. We are not liable for decisions made based on calculator outputs.</p>
  </article>
</Page>
