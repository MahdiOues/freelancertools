---
import Page from '../../layouts/Page.astro';
import AdZone from '../../components/AdZone.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Free Legal Tools for Freelancers",
  "description": "Free legal document generators for freelancers — contract generator, NDA generator, and contract summarizer.",
};
const accent = 'var(--cat-legal)';
const accentBg = 'var(--cat-legal-bg)';
---

<Page
  title="Free Legal Tools for Freelancers — Contract Generator, NDA & More"
  description="Free legal document tools for freelancers. Generate contracts, NDAs, and summarize legal documents with AI."
  canonicalUrl="https://freelancertools.io/legal/"
  schema={schema}
>
  <div class="cat-color-bar" style="--cat-color: var(--cat-legal);"></div>
  <div class="container">
    <Breadcrumb items={[{ label: 'Legal' }]} />
    <div class="cat-hero" style={`--cat-color:${accent};--cat-bg:${accentBg};`}>
      <span class="cat-hero-badge" style={`color:${accent};background:${accentBg};border:1px solid rgba(124,58,237,0.15);`}>Legal</span>
      <h1>Legal tools for freelancers and independent professionals</h1>
      <p>Generate professional contracts, NDAs, and proposals in minutes. Use AI to summarize lengthy legal documents and find the key clauses that matter.</p>
    </div>

    <AdZone size="leaderboard" />

    <section>
      <div style="display: grid; gap: 20px;">
        <div class="hub-tool-card" style={`--cat-accent:${accent};`}>
          <h3><a href="/legal/contract-generator/">Contract Generator</a></h3>
          <p>Generate a freelance contract, invoice, NDA, or proposal in seconds. Select your document type, fill in the details, and get a clean, professional document.</p>
          <a href="/legal/contract-generator/" class="hub-tool-link">Use this tool →</a>
        </div>
        <div class="hub-tool-card" style={`--cat-accent:${accent};`}>
          <h3><a href="/legal/contract-summarizer/">Contract Summarizer</a></h3>
          <p>Paste a legal document and get a plain-English summary. Highlights risky clauses and key obligations so you know what you are signing.</p>
          <a href="/legal/contract-summarizer/" class="hub-tool-link">Use this tool →</a>
        </div>
        <AdZone size="square" />
        <div class="hub-tool-card" style={`--cat-accent:${accent};`}>
          <h3><a href="/legal/nda-generator/">NDA Generator</a></h3>
          <p>Create a mutual or one-way non-disclosure agreement tailored to your project. Covers confidentiality terms, exclusions, and duration.</p>
          <a href="/legal/nda-generator/" class="hub-tool-link">Use this tool →</a>
        </div>
      </div>
    </section>

    <AdZone size="square" />

    <section>
      <h2>Related categories</h2>
      <ul>
        <li><a href="/finance/">Finance tools for freelancers</a></li>
        <li><a href="/saas/">SaaS / B2B calculators</a></li>
        <li><a href="/marketing/">Marketing tools</a></li>
        <li><a href="/freelancer/">Freelancer business tools</a></li>
      </ul>
    </section>

    <AdZone size="footer" />
  </div>
</Page>
