---
import Tool from '../../layouts/Tool.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free AI Contract Summarizer",
  "description": "Paste a legal document and get a plain-English summary. Highlights risky clauses and key obligations.",
  "url": "https://freelancertools.io/legal/contract-summarizer/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Free AI Contract Summarizer"
  description="Paste a legal document and get a plain-English summary. Highlights risky clauses and key obligations so you know what you are signing."
  canonicalUrl="https://freelancertools.io/legal/contract-summarizer/"
  schema={schema}
  breadcrumb={[{ label: 'Legal', href: '/legal/' }, { label: 'Contract Summarizer' }]}
  relatedTools={[
    { name: 'Contract Generator', href: '/legal/contract-generator/', category: 'Legal' },
    { name: 'NDA Generator', href: '/legal/nda-generator/', category: 'Legal' },
    { name: 'Invoice Generator', href: '/freelancer/invoice-generator/', category: 'Freelancer' },
    { name: 'Proposal Generator', href: '/freelancer/proposal-generator/', category: 'Freelancer' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Contract Summarizer</h1>
      <p class="subhead">Paste a contract or legal document and get a plain-English summary. Highlights risky clauses so you never miss something important.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Contract Summarizer</h2>
      </div>
      <div class="calculator-card-body">
      <div class="field">
        <label class="field-label">Paste your contract text</label>
        <textarea id="contractText" rows="10" placeholder="Paste the full contract text here..."></textarea>
      </div>
      <button id="summarizeBtn" class="btn btn-primary btn-full">Summarize</button>

      <div id="errorMsg" style="display: none; margin-top: 12px; font-size: 14px; color: var(--danger);"></div>

      <div id="resultArea" class="result-area" style="display: none;"></div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>Why summarize a contract?</h2>
      <p>Legal documents are dense. They use complex language and buried clauses that can have significant financial implications. This tool extracts the key information and flags anything that might be risky.</p>
      <p>Use it before signing any freelance contract, service agreement, or partnership document. It is not a replacement for legal advice, but it helps you know what questions to ask.</p>
      <p>This is an estimate. Actual results vary.</p>
    </div>
  </fragment>
</Tool>

<script>
async function callAI(prompt, systemPrompt = '') {
  const key = import.meta.env.PUBLIC_ANTHROPIC_KEY;
  const response = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': key,
      'anthropic-version': '2023-06-01',
    },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 1000,
      system: systemPrompt,
      messages: [{ role: 'user', content: prompt }],
    }),
  });

  if (!response.ok) throw new Error(`API error: ${response.status}`);
  const data = await response.json();
  return data.content[0].text;
}

async function summarize() {
  const btn = document.getElementById('summarizeBtn');
  const errorMsg = document.getElementById('errorMsg');
  const resultArea = document.getElementById('resultArea');
  const contractText = document.getElementById('contractText').value.trim();

  if (!contractText) {
    errorMsg.textContent = 'Please paste a contract to summarize.';
    errorMsg.style.display = 'block';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Summarizing...';
  errorMsg.style.display = 'none';
  resultArea.style.display = 'none';

  const systemPrompt = 'You are a legal document analyst. Summarize contracts in plain English. Identify key clauses, obligations, and flag any risky or unusual terms. Output structured sections with clear headings. For risky clauses, prefix with [RISKY] and explain why.';

  const prompt = `Summarize the following contract. List the key clauses in plain English. Flag any risky clauses with [RISKY] and a brief explanation. Include: parties involved, payment terms, duration/termination, IP rights, liability, confidentiality, and any unusual provisions.\n\nContract:\n${contractText}`;

  try {
    const text = await callAI(prompt, systemPrompt);
    const formatted = text
      .replace(/\[RISKY\]/g, '</p><div style="border-left: 3px solid var(--danger); padding-left: 16px; margin: 12px 0;"><p style="font-weight: 600; color: var(--danger); font-size: 14px;">RISKY</p><p style="font-size: 14px;">')
      .replace(/##/g, '</p><h2 style="margin-top: 24px;">')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n/g, '<br />');
    resultArea.innerHTML = `<div style="font-size: 15px;"><p>${formatted}</p></div>`;
    resultArea.style.display = 'block';
  } catch (err) {
    errorMsg.textContent = 'Something went wrong — please try again.';
    errorMsg.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Summarize';
  }
}
document.getElementById('summarizeBtn').addEventListener('click', summarize);
</script>
