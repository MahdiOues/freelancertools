---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';
import DocTemplatePicker from '../../components/DocTemplatePicker.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free AI Contract Generator",
  "description": "Generate a freelance contract, invoice, NDA, or proposal in seconds using AI.",
  "url": "https://freelancertools.io/legal/contract-generator/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="Free AI Contract Generator"
  description="Generate a freelance contract, invoice, NDA, or proposal in seconds using AI. Select your document type, fill in the details, and get a clean, professional document."
  canonicalUrl="https://freelancertools.io/legal/contract-generator/"
  schema={schema}
  breadcrumb={[{ label: 'Legal', href: '/legal/' }, { label: 'Contract Generator' }]}
  relatedTools={[
    { name: 'Contract Summarizer', href: '/legal/contract-summarizer/', category: 'Legal' },
    { name: 'NDA Generator', href: '/legal/nda-generator/', category: 'Legal' },
    { name: 'Invoice Generator', href: '/freelancer/invoice-generator/', category: 'Freelancer' },
    { name: 'Proposal Generator', href: '/freelancer/proposal-generator/', category: 'Freelancer' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Contract Generator</h1>
      <p class="subhead">Generate professional legal documents in under a minute. AI-powered, plain text output — copy, print, or save.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Contract Generator</h2>
      </div>
      <div class="calculator-card-body">
      <div class="field-grid">
        <div class="field">
          <label class="field-label">Language</label>
          <select id="language">
            <option value="English">English</option>
            <option value="Spanish">Spanish</option>
            <option value="French">French</option>
            <option value="German">German</option>
          </select>
        </div>
        <div class="field">
          <label class="field-label">Document type</label>
          <div id="docType">
            <label style="display: block; margin-bottom: 6px; font-size: 14px;"><input type="radio" name="docType" value="Freelance Contract" checked /> Freelance Contract</label>
            <label style="display: block; margin-bottom: 6px; font-size: 14px;"><input type="radio" name="docType" value="Invoice" /> Invoice</label>
            <label style="display: block; margin-bottom: 6px; font-size: 14px;"><input type="radio" name="docType" value="NDA" /> NDA</label>
            <label style="display: block; font-size: 14px;"><input type="radio" name="docType" value="Proposal" /> Proposal</label>
          </div>
        </div>
      </div>

      <div id="contractFields">
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Your name / company" tip="The legal name that will appear as the service provider on the contract. Use your registered business name if you have one." /></label>
            <input type="text" id="yourName" placeholder="e.g. Jane Doe" />
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Client name / company" tip="The full legal name of the client or business you're contracting with. This is who the contract is legally binding on." /></label>
            <input type="text" id="clientName" placeholder="e.g. Acme Corp" />
          </div>
        </div>
        <div class="field">
          <label class="field-label">Project description</label>
          <textarea id="projectDesc" placeholder="Describe the work to be done..."></textarea>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Project value ($)" tip="The total project fee or rate. Make sure this matches what you've verbally agreed so there's no ambiguity." /></label>
            <input type="number" id="projectValue" value="5000" />
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Timeline" tip="Key milestones and the final deadline. Include what happens if the client delays feedback — this protects your schedule." /></label>
            <input type="text" id="timeline" placeholder="e.g. 4 weeks" />
          </div>
        </div>
      </div>

      <div id="invoiceFields" style="display: none;">
        <div class="field-grid">
          <div class="field">
            <label class="field-label">Your name</label>
            <input type="text" id="invYourName" placeholder="Your name" />
          </div>
          <div class="field">
            <label class="field-label">Client name</label>
            <input type="text" id="invClientName" placeholder="Client name" />
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label">Invoice number</label>
            <input type="text" id="invNumber" placeholder="e.g. INV-001" />
          </div>
          <div class="field">
            <label class="field-label">Amount ($)</label>
            <input type="number" id="invAmount" value="2500" />
          </div>
        </div>
        <div class="field">
          <label class="field-label">Description</label>
          <textarea id="invDesc" placeholder="Description of services..."></textarea>
        </div>
      </div>

      <div id="ndaFields" style="display: none;">
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Disclosing party" tip="The person or company sharing the confidential information — usually you or your client depending on the situation." /></label>
            <input type="text" id="ndaParty1" placeholder="e.g. Acme Corp" />
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Receiving party" tip="The person or company receiving and agreeing to keep confidential the disclosed information." /></label>
            <input type="text" id="ndaParty2" placeholder="e.g. Jane Doe" />
          </div>
        </div>
        <div class="field">
          <label class="field-label">Purpose of disclosure</label>
          <textarea id="ndaPurpose" placeholder="Describe why confidential info is being shared..."></textarea>
        </div>
      </div>

      <div id="proposalFields" style="display: none;">
        <div class="field-grid">
          <div class="field">
            <label class="field-label">Your name</label>
            <input type="text" id="propYourName" placeholder="Your name" />
          </div>
          <div class="field">
            <label class="field-label">Client name</label>
            <input type="text" id="propClientName" placeholder="Client name" />
          </div>
        </div>
        <div class="field">
          <label class="field-label"><KpiTooltip label="Project overview" tip="Your understanding of what the client needs and why. Demonstrating you understand their problem is more persuasive than listing your services." /></label>
          <textarea id="propOverview" placeholder="Brief overview of the project..."></textarea>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-label"><KpiTooltip label="Deliverables" tip="What you will specifically produce or complete. Concrete deliverables reduce perceived risk for the client." /></label>
            <textarea id="propDeliverables" placeholder="List key deliverables..." rows="3"></textarea>
          </div>
          <div class="field">
            <label class="field-label"><KpiTooltip label="Timeline" tip="Your estimated schedule from kickoff to final delivery. Include key milestones to show you've thought through the work." /></label>
            <input type="text" id="propTimeline" placeholder="e.g. 6 weeks" />
          </div>
        </div>
        <div class="field">
          <label class="field-label"><KpiTooltip label="Investment ($)" tip="Your price range for the project. Using a range (e.g. $2,000–$2,500) instead of a fixed price gives flexibility and anchors the conversation." /></label>
          <input type="number" id="propInvestment" value="10000" />
        </div>
      </div>

      <DocTemplatePicker />

      <button id="generateBtn" class="btn btn-primary btn-full">Generate Document</button>

      <div id="errorMsg" style="display: none; margin-top: 12px; font-size: 14px; color: var(--danger);"></div>

      <div class="doc-output-wrap" id="doc-output-wrap" style="display:none">
        <div id="doc-output"></div>
        <div class="btn-row">
          <button class="btn btn-secondary" id="copyBtn" type="button">Copy text</button>
          <button class="btn btn-secondary" id="btn-pdf" type="button">Export as PDF</button>
        </div>
      </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>When to use a contract generator</h2>
      <p>A written contract protects both you and your client. It sets clear expectations about scope, payment, deadlines, and what happens if something goes wrong. This generator creates documents in plain English that are professional and ready to use.</p>
      <p>While these documents are legally sound templates, they are not a substitute for professional legal advice. For high-stakes contracts, have a lawyer review your documents.</p>
      <p>This is an estimate. Actual results vary.</p>
    </div>
  </fragment>
</Tool>

<script>
import { renderDocument } from '/src/scripts/doc-renderer.js';

let selectedTemplate = 'classic';
let lastDocData = null;

document.addEventListener('tpl:change', e => {
  selectedTemplate = e.detail.template;
  if (lastDocData) {
    document.getElementById('doc-output').innerHTML =
      renderDocument(lastDocData, selectedTemplate);
  }
});

function toggleFields() {
  const type = document.querySelector('input[name="docType"]:checked').value;
  document.getElementById('contractFields').style.display = type === 'Freelance Contract' ? 'block' : 'none';
  document.getElementById('invoiceFields').style.display = type === 'Invoice' ? 'block' : 'none';
  document.getElementById('ndaFields').style.display = type === 'NDA' ? 'block' : 'none';
  document.getElementById('proposalFields').style.display = type === 'Proposal' ? 'block' : 'none';
  document.getElementById('doc-output-wrap').style.display = 'none';
  document.getElementById('errorMsg').style.display = 'none';
}

const pick = arr => arr[Math.floor(Math.random() * arr.length)];
const fill = (template, data) => template.replace(/\{\{(\w+)\}\}/g, (_, key) => data[key] || `[${key}]`);

// --- Freelance Contract Templates ---
const contractOpening = [
