// --- Generator Functions ---

function generateContract(data) {
  return [
    { heading: 'Introduction', body: fill(pick(contractOpening), data) },
    { heading: 'Scope of Work', body: fill(pick(contractScope), data) },
    { heading: 'Payment', body: fill(pick(contractPayment), data) },
    { heading: 'Revisions', body: fill(pick(contractRevisions), data) },
    { heading: 'Intellectual Property', body: fill(pick(contractIP), data) },
    { heading: 'Kill Fee', body: fill(pick(contractKillFee), data) },
    { heading: 'Confidentiality', body: fill(pick(contractConfidentiality), data) },
    { heading: 'Termination', body: fill(pick(contractTermination), data) },
  ];
}

function generateInvoice(data) {
  const dueDate = new Date();
  dueDate.setDate(dueDate.getDate() + 30);
  const dateStr = dueDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  const paymentNote = fill(pick(invoicePaymentNotes), { ...data, dueDate: dateStr, lateFee: '1.5' });
  const footer = fill(pick(invoiceThankYou), data);
  return [
    { heading: 'Description', body: data.invDesc },
    { heading: 'Amount Due', body: `$${data.invAmount}` },
    { heading: 'Payment Terms', body: paymentNote },
    { heading: '', body: footer },
  ];
}

function generateNDA(data) {
  return [
    { heading: 'Introduction', body: fill(pick(ndaIntroduction), data) },
    { heading: 'Definition of Confidential Information', body: fill(pick(ndaDefinition), data) },
    { heading: 'Obligations of the Receiving Party', body: pick(ndaObligations) },
    { heading: 'Exclusions', body: pick(ndaExclusions) },
    { heading: 'Duration', body: fill(pick(ndaDuration), data) },
    { heading: 'Governing Law', body: pick(ndaJurisdiction) },
  ];
}

function generateProposal(data) {
  return [
    { heading: 'Opening', body: fill(pick(proposalOpening), data) },
    { heading: 'Understanding of Needs', body: fill(pick(proposalUnderstanding), data) },
    { heading: 'Approach', body: pick(proposalApproach) },
    { heading: 'Deliverables', body: fill(pick(proposalDeliverables), data) },
    { heading: 'Timeline', body: fill(pick(proposalTimeline), data) },
    { heading: 'Investment', body: fill(pick(proposalInvestment), data) },
    { heading: 'Closing', body: fill(pick(proposalClosing), data) },
  ];
}

function displayDocument(sections, meta) {
  lastDocData = { ...meta, sections };
  const wrap = document.getElementById('doc-output-wrap');
  document.getElementById('doc-output').innerHTML =
    renderDocument(lastDocData, selectedTemplate);
  wrap.style.display = 'block';
  wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function generate() {
  const errorMsg = document.getElementById('errorMsg');
  const wrap = document.getElementById('doc-output-wrap');
  errorMsg.style.display = 'none';
  wrap.style.display = 'none';

  const type = document.querySelector('input[name="docType"]:checked').value;

  try {
    let sections, meta;
    const today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    if (type === 'Freelance Contract') {
      const data = {
        yourName: document.getElementById('yourName').value || '[Your Name]',
        clientName: document.getElementById('clientName').value || '[Client Name]',
        projectTitle: document.getElementById('projectDesc').value || '[Project Description]',
        overview: document.getElementById('projectDesc').value || '[Project Description]',
        deliverables: document.getElementById('projectDesc').value || '[Project Description]',
        paymentAmount: document.getElementById('projectValue').value || '0',
        paymentTerms: '50% upfront, 50% on delivery',
        revisions: '2',
        timeline: document.getElementById('timeline').value || '[Timeline]',
      };
      sections = generateContract(data);
      meta = { title: 'Freelance Service Agreement', from: data.yourName, to: data.clientName, date: today, docType: 'contract' };
    } else if (type === 'Invoice') {
      const invYourName = document.getElementById('invYourName').value || '[Your Name]';
      const invClientName = document.getElementById('invClientName').value || '[Client Name]';
      const data = {
        yourName: invYourName,
        clientName: invClientName,
        invNumber: document.getElementById('invNumber').value || 'INV-001',
        invAmount: document.getElementById('invAmount').value || '0',
        invDesc: document.getElementById('invDesc').value || '[Description]',
      };
      sections = generateInvoice(data);
      meta = { title: 'Invoice', from: data.yourName, to: data.clientName, date: today, num: data.invNumber, docType: 'invoice' };
    } else if (type === 'NDA') {
      const party1 = document.getElementById('ndaParty1').value || '[Party 1]';
      const party2 = document.getElementById('ndaParty2').value || '[Party 2]';
      const data = { party1, party2, purpose: document.getElementById('ndaPurpose').value || '[Purpose]', duration: '2' };
      sections = generateNDA(data);
      meta = { title: 'Non-Disclosure Agreement', from: data.party1, to: data.party2, date: today, docType: 'nda' };
    } else if (type === 'Proposal') {
      const propYourName = document.getElementById('propYourName').value || '[Your Name]';
      const propClientName = document.getElementById('propClientName').value || '[Client Name]';
      const data = {
        yourName: propYourName,
        clientName: propClientName,
        projectTitle: document.getElementById('propOverview').value || '[Project Overview]',
        overview: document.getElementById('propOverview').value || '[Project Overview]',
        deliverables: document.getElementById('propDeliverables').value || '[Deliverables]',
        timeline: document.getElementById('propTimeline').value || '[Timeline]',
        investment: document.getElementById('propInvestment').value || '0',
      };
      sections = generateProposal(data);
      meta = { title: 'Project Proposal', from: data.yourName, to: data.clientName, date: today, docType: 'proposal' };
    }
    displayDocument(sections, meta);
  } catch (err) {
    errorMsg.textContent = 'Something went wrong — please try again.';
    errorMsg.style.display = 'block';
  }
}

function copyDoc() {
  const el = document.getElementById('doc-output');
  navigator.clipboard.writeText(el.textContent || el.innerText);
}

toggleFields();
document.getElementById('generateBtn').addEventListener('click', generate);
document.getElementById('copyBtn').addEventListener('click', copyDoc);
document.getElementById('btn-pdf').addEventListener('click', () => window.print());
document.querySelectorAll('input[name="docType"]').forEach(el => el.addEventListener('change', toggleFields));
</script>
