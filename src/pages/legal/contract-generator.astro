// --- Invoice Templates ---
const invoicePaymentNotes = [
  `Payment is due by {{dueDate}}. Accounts overdue by more than 14 days will be charged a {{lateFee}}% monthly late fee.`,
  `Please remit payment by {{dueDate}}. A late fee of {{lateFee}}% per month applies to overdue balances.`,
  `Invoice due: {{dueDate}}. Payments received after this date are subject to a {{lateFee}}% monthly interest charge.`,
