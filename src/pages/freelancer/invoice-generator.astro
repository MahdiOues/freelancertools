---
import Tool from '../../layouts/ToolWithExcel.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';
import DocTemplatePicker from '../../components/DocTemplatePicker.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free AI Invoice Generator",
  "description": "Generate a professional invoice with all standard fields, payment terms, and late fee notices using AI.",
  "url": "https://www.megalancer.online/freelancer/invoice-generator/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="AI Invoice Generator for Freelancers — Free | MegaLancer"
  description="Create professional freelance invoices in seconds. Add payment terms, late fee clauses, and download as PDF. Free AI invoicing tool for freelancers."
  canonicalUrl="https://www.megalancer.online/freelancer/invoice-generator/"
  schema={schema}
  breadcrumb={[{ label: 'Freelancer', href: '/freelancer/' }, { label: 'Invoice Generator' }]}
  relatedTools={[
    { name: 'Freelancer Rate Calculator', href: '/freelancer/rate-calculator/', category: 'Freelancer' },
    { name: 'Proposal Generator', href: '/freelancer/proposal-generator/', category: 'Freelancer' },
    { name: 'Contract Generator', href: '/legal/contract-generator/', category: 'Legal' },
    { name: 'NDA Generator', href: '/legal/nda-generator/', category: 'Legal' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>Free AI Invoice Generator for Freelancers</h1>
      <p class="subhead">Generate a professional invoice in seconds. Fill in your details and get a clean, printable invoice ready to send.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>Invoice Generator</h2>
      </div>
      <div class="calculator-card-body">
      <div class="field-grid">
        <div class="field">
          <label class="field-label"><KpiTooltip label="Your name / company" tip="Your name or registered business name as it appears on official documents. This is the &quot;From&quot; on the invoice." /></label>
          <input type="text" id="yourName" placeholder="Your name" />
        </div>
        <div class="field">
          <label class="field-label"><KpiTooltip label="Client name / company" tip="The full legal name of the business or person you're billing." /></label>
          <input type="text" id="clientName" placeholder="Client name" />
        </div>
      </div>
      <div class="field-grid">
        <div class="field">
          <label class="field-label">Your email</label>
          <input type="email" id="yourEmail" placeholder="you@example.com" />
        </div>
        <div class="field">
          <label class="field-label">Client email</label>
          <input type="email" id="clientEmail" placeholder="client@example.com" />
        </div>
      </div>
      <div class="field-grid">
        <div class="field">
          <label class="field-label"><KpiTooltip label="Invoice number" tip="A unique identifier for this invoice. Sequential numbering (INV-001, INV-002) makes bookkeeping and tax filing easier." /></label>
          <input type="text" id="invNumber" placeholder="e.g. INV-001" />
        </div>
        <div class="field">
          <label class="field-label"><KpiTooltip label="Invoice date" tip="The date the invoice is issued. Payment due dates are typically calculated from this date." /></label>
          <input type="date" id="invDate" />
        </div>
      </div>
      <div class="field-grid">
        <div class="field">
          <label class="field-label">Amount ($)</label>
          <input type="number" id="amount" value="2500" />
        </div>
        <div class="field">
          <label class="field-label"><KpiTooltip label="Due date" tip="When payment is expected. Net-15 (15 days) or Net-30 (30 days) from invoice date are common terms." /></label>
          <input type="date" id="dueDate" />
        </div>
      </div>
      <div class="field">
        <label class="field-label"><KpiTooltip label="Description of services" tip="A description of each service or deliverable being billed. Be specific — it reduces disputes and looks more professional." /></label>
        <textarea id="description" placeholder="Describe the work or products being invoiced..."></textarea>
      </div>
      <DocTemplatePicker />

      <button id="generateBtn" class="btn btn-primary btn-full">Generate Invoice</button>

      <div id="errorMsg" style="display: none; margin-top: 12px; font-size: 14px; color: var(--danger);"></div>

      <div class="doc-output-wrap" id="doc-output-wrap" style="display:none">
        <div id="doc-output"></div>
        <div class="btn-row">
          <button class="btn btn-secondary" id="copyBtn" type="button">Copy text</button>
          <button class="btn btn-secondary" id="btn-pdf" type="button">Export as PDF</button>
        </div>
      </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>Why professional invoices matter</h2>
      <p>A professional invoice does more than request payment. It reinforces your brand, sets clear payment terms, and protects you if a client is late. This generator creates invoices with all standard fields plus a late fee notice.</p>
      <p>Always include payment terms, late fee policies, and your preferred payment methods. Clear invoices get paid faster.</p>
      <p>This is an estimate. Actual results vary.</p>
    </div>
  </fragment>
</Tool>

<script>
import { renderDocument } from '/src/scripts/doc-renderer.js';

let selectedTemplate = 'classic';
let lastDocData = null;

document.addEventListener('tpl:change', e => {
  selectedTemplate = e.detail.template;
  if (lastDocData) {
    document.getElementById('doc-output').innerHTML =
      renderDocument(lastDocData, selectedTemplate);
  }
});

function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
function fill(template, data) { return template.replace(/\{\{(\w+)\}\}/g, (_, key) => data[key] ?? ''); }

const paymentNotes = [
  "Payment is due by {{dueDate}}. Accounts overdue by more than 14 days will be charged a {{lateFee}}% monthly late fee.",
  "Please remit payment by {{dueDate}}. A late fee of {{lateFee}}% per month applies to overdue balances.",
  "Invoice due: {{dueDate}}. Payments received after this date are subject to a {{lateFee}}% monthly interest charge.",
  "Full payment expected by {{dueDate}}. Overdue invoices accrue interest at {{lateFee}}% per month.",
  "Due date: {{dueDate}}. Late payments will incur a {{lateFee}}% monthly fee on the outstanding balance.",
  "This invoice is payable by {{dueDate}}. A {{lateFee}}% monthly late fee applies after that date.",
  "Kindly arrange payment before {{dueDate}}. Overdue amounts will be charged at {{lateFee}}% per month.",
  "Payment terms: due by {{dueDate}}. Interest of {{lateFee}}% per month will be applied to any overdue balance.",
  "Please ensure payment is received by {{dueDate}} to avoid a {{lateFee}}% monthly late charge.",
  "Net due {{dueDate}}. Any balance unpaid after this date will accrue a {{lateFee}}% monthly fee.",
];

const thankYouFooters = [
  "Thank you for your business. — {{yourName}}",
  "It's been a pleasure working with you. — {{yourName}}",
  "Looking forward to working together again. — {{yourName}}",
  "Thank you for the opportunity. — {{yourName}}",
  "Appreciate your trust in my work. — {{yourName}}",
  "Thanks for a great project. — {{yourName}}",
  "Grateful for your continued partnership. — {{yourName}}",
  "It was a pleasure delivering this work for you. — {{yourName}}",
  "Thank you — I hope to work together again soon. — {{yourName}}",
  "With appreciation, {{yourName}}",
];

function displayDocument(sections, meta) {
  lastDocData = { ...meta, sections };
  const wrap = document.getElementById('doc-output-wrap');
  document.getElementById('doc-output').innerHTML =
    renderDocument(lastDocData, selectedTemplate);
  wrap.style.display = 'block';
  wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function generate() {
  const errorMsg = document.getElementById('errorMsg');
  const wrap = document.getElementById('doc-output-wrap');
  errorMsg.style.display = 'none';
  wrap.style.display = 'none';

  const yourName = document.getElementById('yourName').value || '[Your Name]';
  const clientName = document.getElementById('clientName').value || '[Client Name]';
  const yourEmail = document.getElementById('yourEmail').value || '[Your Email]';
  const clientEmail = document.getElementById('clientEmail').value || '[Client Email]';
  const invNumber = document.getElementById('invNumber').value || '[Invoice Number]';
  const invDate = document.getElementById('invDate').value || new Date().toISOString().split('T')[0];
  const amount = document.getElementById('amount').value || '0';
  const dueDate = document.getElementById('dueDate').value || '[Due Date]';
  const description = document.getElementById('description').value || '[Description]';

  const randomNote = fill(pick(paymentNotes), { dueDate, lateFee: '1.5' });
  const randomFooter = fill(pick(thankYouFooters), { yourName });

  const sections = [
    { heading: 'Contact', body: `From: ${yourName} (${yourEmail})\nTo: ${clientName} (${clientEmail})` },
    { heading: 'Description of Services', body: description },
    { heading: 'Amount Due', body: `$${amount}` },
    { heading: 'Payment Terms', body: randomNote },
    { heading: '', body: randomFooter },
  ];

  displayDocument(sections, {
    title: 'Invoice',
    from: yourName,
    to: clientName,
    date: invDate,
    num: invNumber,
    docType: 'invoice'
  });
}

function copyDoc() {
  const el = document.getElementById('doc-output');
  navigator.clipboard.writeText(el.textContent || el.innerText);
}

document.getElementById('generateBtn').addEventListener('click', generate);
document.getElementById('copyBtn').addEventListener('click', copyDoc);
document.getElementById('btn-pdf').addEventListener('click', () => window.print());
</script>
