---
import Page from '../../layouts/Page.astro';
import AdZone from '../../components/AdZone.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Free Math Calculators & Converters",
  "description": "Free online math calculators — percentage, GPA, scientific, unit conversions, time zones, and more.",
