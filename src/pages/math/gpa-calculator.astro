---
import Tool from '../../layouts/Tool.astro';
import KpiTooltip from '../../components/KpiTooltip.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free GPA Calculator",
  "description": "Calculate your GPA on a 4.0 scale. Add courses with letter grades or percentages and credit hours. Supports weighted grading.",
  "url": "https://www.megalancer.online/math/gpa-calculator/",
  "applicationCategory": "BusinessApplication",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0" }
};
---

<Tool
  title="GPA Calculator — College GPA"
  description="Calculate your college GPA quickly. Add courses with grades and credit hours. Supports letter grades, percentages, and weighted grading."
  canonicalUrl="https://www.megalancer.online/math/gpa-calculator/"
  schema={schema}
  breadcrumb={[{ label: 'Math', href: '/math/' }, { label: 'GPA Calculator' }]}
  relatedTools={[
    { name: 'Grade Calculator', href: '/math/grade-calculator/', category: 'Math' },
    { name: 'Percentage Calculator', href: '/math/percentage-calculator/', category: 'Math' },
    { name: 'Age Calculator', href: '/math/age-calculator/', category: 'Math' },
    { name: 'Scientific Calculator', href: '/math/scientific-calculator/', category: 'Math' },
  ]}
>
  <fragment slot="hero">
    <div class="tool-page-hero">
      <h1>GPA Calculator</h1>
      <p class="subhead">Calculate your GPA on a standard 4.0 scale. Add your courses, grades, and credit hours to see your cumulative GPA.</p>
    </div>
  </fragment>
  <fragment slot="tool">
    <div class="calculator-card">
      <div class="calculator-card-header">
        <h2>GPA Calculator</h2>
      </div>
      <div class="calculator-card-body">
        <div class="field">
          <label class="field-label">Grade input type</label>
          <select id="gradeType">
            <option value="letter">Letter grades (A, B+, etc.)</option>
            <option value="percent">Percentage grades</option>
          </select>
        </div>
        <div id="courses"></div>
        <button id="addCourse" class="btn btn-secondary" style="width:100%;margin-top:12px;">+ Add course</button>

        <div id="resultArea" class="result-area">
          <div class="result-empty">Add courses to calculate your GPA.</div>
        </div>
      </div>
    </div>
  </fragment>
  <fragment slot="seo">
    <div class="seo-body">
      <h2>How GPA is calculated</h2>
      <p>Your Grade Point Average (GPA) is calculated by dividing the total number of grade points earned by the total number of credit hours attempted. On the standard 4.0 scale, an A is worth 4.0 points, B is 3.0, C is 2.0, D is 1.0, and F is 0. Plus and minus grades adjust these values (e.g., B+ = 3.3, A- = 3.7).</p>
      <p>For percentage grades, the calculator converts your percentage to a letter grade first. Generally, 90-100% is an A, 80-89% is a B, 70-79% is a C, 60-69% is a D, and below 60% is an F. Individual institutions may vary.</p>
      <h2>Why your GPA matters</h2>
      <p>Your GPA affects academic standing, scholarship eligibility, graduate school admissions, and some entry-level job applications. A GPA of 3.0 or higher is generally considered good, while 3.5+ is competitive for graduate programs. Use this calculator to track your progress and plan your academic goals.</p>
    </div>
  </fragment>
</Tool>

<script>
const letterGrades = { 'A+': 4.0, 'A': 4.0, 'A-': 3.7, 'B+': 3.3, 'B': 3.0, 'B-': 2.7, 'C+': 2.3, 'C': 2.0, 'C-': 1.7, 'D+': 1.3, 'D': 1.0, 'F': 0.0 };

function pctToGrade(pct) {
  if (pct >= 90) return 4.0; if (pct >= 80) return 3.0; if (pct >= 70) return 2.0; if (pct >= 60) return 1.0; return 0.0;
}

let courseCount = 0;

function addCourseRow(name, grade, credits) {
  courseCount++;
  const div = document.createElement('div');
  div.className = 'course-row';
  div.style.cssText = 'display:grid;grid-template-columns:1fr 1fr 80px auto;gap:8px;margin-bottom:10px;align-items:end;';
  div.innerHTML = `
    <div class="field" style="margin:0;">
      <label class="field-label" style="font-size:10px;">Course</label>
      <input type="text" class="course-name" value="${name}" placeholder="e.g. Math 101" />
    </div>
    <div class="field" style="margin:0;" id="gradeField_${courseCount}">
      <label class="field-label" style="font-size:10px;">Grade</label>
      ${document.getElementById('gradeType').value === 'letter'
        ? `<select class="course-grade-letter"><option>A</option><option>A-</option><option selected>B+</option><option>B</option><option>B-</option><option>C+</option><option>C</option><option>C-</option><option>D+</option><option>D</option><option>F</option></select>`
        : `<input type="number" class="course-grade-pct" value="85" min="0" max="100" />`
      }
    </div>
    <div class="field" style="margin:0;">
      <label class="field-label" style="font-size:10px;">Credits</label>
      <input type="number" class="course-credits" value="${credits || 3}" min="0.5" step="0.5" />
    </div>
    <button class="btn btn-secondary remove-course" style="padding:8px 12px;margin-bottom:0;font-size:13px;">X</button>
  `;
  document.getElementById('courses').appendChild(div);
  div.querySelector('.remove-course').addEventListener('click', function() {
    div.remove();
    calculate();
  });
  div.querySelectorAll('input,select').forEach(el => el.addEventListener('input', calculate));
  calculate();
}

function calculate() {
  const rows = document.querySelectorAll('.course-row');
  if (rows.length === 0) {
    document.getElementById('resultArea').innerHTML = `<div class="result-empty">Add courses to calculate your GPA.</div>`;
    return;
  }
  let totalPoints = 0, totalCredits = 0;
  rows.forEach(row => {
    const credits = parseFloat(row.querySelector('.course-credits').value) || 0;
    let gradePoints = 0;
    const gradeSelect = row.querySelector('.course-grade-letter');
    const gradePct = row.querySelector('.course-grade-pct');
    if (gradeSelect) {
      gradePoints = letterGrades[gradeSelect.value] || 0;
    } else if (gradePct) {
      gradePoints = pctToGrade(parseFloat(gradePct.value) || 0);
    }
    totalPoints += gradePoints * credits;
    totalCredits += credits;
  });
  const gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
  const letterMap = { '4.0': 'A', '3.7': 'A-', '3.3': 'B+', '3.0': 'B', '2.7': 'B-', '2.3': 'C+', '2.0': 'C', '1.7': 'C-', '1.3': 'D+', '1.0': 'D', '0': 'F' };
  let letter = 'F';
  for (const [threshold, grade] of Object.entries(letterMap)) {
    if (gpa >= parseFloat(threshold)) { letter = grade; break; }
  }

  document.getElementById('resultArea').innerHTML = `
    <div class="metric-grid">
      <div class="metric-card">
        <div class="result-number">${gpa.toFixed(2)}</div>
        <div class="result-label">Cumulative GPA</div>
      </div>
      <div class="metric-card">
        <div class="result-number">${letter}</div>
        <div class="result-label">Letter equivalent</div>
      </div>
      <div class="metric-card">
        <div class="result-number">${totalCredits}</div>
        <div class="result-label">Total credits</div>
      </div>
    </div>
  `;
}

document.getElementById('addCourse').addEventListener('click', () => addCourseRow('', '', 3));
document.getElementById('gradeType').addEventListener('change', function() {
  document.getElementById('courses').innerHTML = '';
  courseCount = 0;
  addCourseRow('Math 101', '', 3);
  addCourseRow('English 101', '', 3);
  addCourseRow('History 101', '', 3);
});
addCourseRow('Math 101', '', 3);
addCourseRow('English 101', '', 3);
addCourseRow('History 101', '', 3);
</script>
