---
interface Props {
  items: { name: string; href: string; category: string }[];
}
const { items } = Astro.props;
---

<div class="related-tools">
  <h2>Related tools</h2>
  <ul class="related-tools-list">
    {items.map(item => (
      <li>
        <a href={item.href}>{item.name}</a>
        <span class="cat-tag">{item.category}</span>
      </li>
    ))}
  </ul>
</div>
